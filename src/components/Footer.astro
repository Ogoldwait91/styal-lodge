---
const links = [
  { label: "The Experience", href: "/#experience" },
  { label: "Feasting", href: "/#feasting" },
  { label: "Stories", href: "/#stories" },
  { label: "FAQs", href: "/#faqs" },
];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/" aria-label="Styal Lodge — home">
        <img src="/logo-light.svg" width="971" height="617" alt="Styal Lodge" />
      </a>
      <p class="site-footer__tagline">Every love story deserves a beautiful beginning.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      {links.map((l) => (<a href={l.href}>{l.label}</a>))}
    </nav>

    <address class="site-footer__contact">
      Styal Lodge, Station Road, Styal, Cheshire SK9 4JN<br />
      <a href="mailto:info@styallodge.co.uk">info@styallodge.co.uk</a><br />
      <a href="tel:+441625416376">01625 416 376</a>
    </address>

    <p class="site-footer__legal">
      <span>&copy; {year} Styal Lodge</span>
      <span aria-hidden="true">·</span>
      <a href="https://www.instagram.com/styallodge/">Instagram</a>
      <span aria-hidden="true">·</span>
      <a href="https://www.tiktok.com/@styallodge">TikTok</a>
    </p>
  </div>
</footer>

<style>
  /* The original centred stack, with refined spacing and type. */
  .site-footer { background: var(--surface-dark); color: var(--on-dark); }
  .site-footer__inner {
    display: grid; justify-items: center; text-align: center;
    gap: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
    padding-top: clamp(3.5rem, 2rem + 5vw, 5.5rem);
    padding-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }
  .site-footer__brand { display: grid; justify-items: center; gap: var(--space-md); }
  .site-footer__logo img { height: clamp(62px, 5vw, 76px); width: auto; }
  .site-footer__tagline {
    margin: 0; font-style: italic; line-height: 1.4;
    font-size: var(--text-lg); letter-spacing: 0; color: var(--on-dark-muted);
  }
  .site-footer__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem clamp(1.25rem, 3vw, 2.5rem); }
  .site-footer__nav a,
  .site-footer__contact { font-size: var(--text-sm); letter-spacing: 0.015em; }
  .site-footer__nav a { color: var(--on-dark); text-decoration: none; transition: color .25s ease; }
  .site-footer__nav a:hover { color: var(--on-dark-muted); }
  .site-footer__contact { font-style: normal; color: var(--on-dark-muted); line-height: 1.9; }
  .site-footer__contact a { color: var(--on-dark); text-decoration: none; transition: color .25s ease; }
  .site-footer__contact a:hover { color: var(--on-dark-muted); }
  .site-footer__legal {
    width: 100%; margin-top: clamp(.5rem, 1vw, 1rem);
    padding-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-top: 1px solid rgba(244, 241, 234, .16);
    display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem .75rem;
    font-size: var(--text-xs); letter-spacing: 0.03em; color: var(--on-dark-muted);
  }
  .site-footer__legal a { color: var(--on-dark-muted); text-decoration: none; transition: color .25s ease; }
  .site-footer__legal a:hover { color: var(--on-dark); }
</style>
