---
/*
  Back of house — Winter in Styal. For management, not couples.
  Shows what a couple paid and how it splits between Follow the Smoke, Special Days and the Lodge,
  checks supplier invoices against that, and keeps a list of saved weddings with running totals.
  Every rate comes from src/data/back-of-house.json. Nothing here needs editing when rates change.
  The page is not linked from anywhere and asks search engines not to list it.
*/
import Base from "../layouts/Base.astro";
import rates from "../data/back-of-house.json";

const years = Object.keys(rates.years);
// Package and extra guests are invoiced separately, so each supplier has two invoices to check.
const INVOICES = [
  { id: "ftsBase", label: `${rates.suppliers.fts}: package invoice` },
  { id: "ftsExtra", label: `${rates.suppliers.fts}: extra guests invoice` },
  { id: "sdBase", label: `${rates.suppliers.sd}: package invoice` },
  { id: "sdExtra", label: `${rates.suppliers.sd}: extra guests invoice` },
];
---
<Base
  title="Back of house — Styal Lodge"
  description="Winter in Styal costs: where each wedding's fees go."
  showFloatingCta={false}
  standalone={true}
>
  <main id="main" class="boh-page">
    <header class="boh-mast container">
      <img class="boh-mast__logo" src="/logo-dark.svg" width="971" height="617" alt="Styal Lodge — Wedding Venue, Cheshire" />
      <p class="eyebrow">Back of house</p>
      <h1 class="display">Winter in Styal <em>costs</em></h1>
    </header>

    <div class="boh container">
      <!-- ============ The wedding ============ -->
      <form class="boh-form" id="boh" novalidate>
        <fieldset class="boh-field">
          <legend>Year</legend>
          <div class="boh-chips">
            {years.map((y) => (
              <label class="boh-chip"><input type="radio" name="year" value={y} /><span>{y}</span></label>
            ))}
          </div>
        </fieldset>

        <fieldset class="boh-field">
          <legend>Day of the wedding</legend>
          <div class="boh-chips">
            {rates.dayTypes.map((d) => (
              <label class="boh-chip"><input type="radio" name="day" value={d.id} /><span>{d.label}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="boh-field">
          <p class="boh-legend">Guests beyond the {rates.includedGuests} in the package</p>
          <div class="boh-steppers">
            {rates.guestTypes.map((g) => (
              <div class="boh-stepper" data-child={g.child ? "" : undefined} hidden={g.child}>
                <label for={`g-${g.id}`}>{g.label}<small>{g.hint}</small></label>
                <div class="boh-stepper__ctrl">
                  <button type="button" data-step={g.id} data-dir="-1" aria-label={`Fewer: ${g.label}, ${g.hint}`}>−</button>
                  <input id={`g-${g.id}`} name={g.id} type="number" inputmode="numeric" min="0" max="300" value="0" />
                  <button type="button" data-step={g.id} data-dir="1" aria-label={`More: ${g.label}, ${g.hint}`}>+</button>
                </div>
              </div>
            ))}
          </div>
          <button type="button" class="boh-link" data-children>Add children</button>
        </div>
      </form>

      <!-- ============ Where the money goes ============ -->
      <section class="boh-card" id="result" aria-live="polite">
        <p class="eyebrow">Where the money goes</p>
        <div class="boh-split">
          <p class="boh-split__who">{rates.suppliers.fts} <small>no VAT</small></p>
          <dl>
            <div><dt>Package</dt><dd data-out="ftsBase"></dd></div>
            <div><dt>Extra guests</dt><dd data-out="ftsExtra"></dd></div>
          </dl>
          <p class="boh-split__who">{rates.suppliers.sd}</p>
          <dl>
            <div><dt>Package</dt><dd data-out="sdBase"></dd></div>
            <div><dt>Extra guests</dt><dd data-out="sdExtra"></dd></div>
          </dl>
        </div>
        <dl class="boh-three">
          <div class="boh-three__lodge"><dt>{rates.suppliers.lodge} keeps</dt><dd data-out="lodge"></dd></div>
        </dl>
        <p class="boh-paid"><span>The couple paid</span><strong data-out="paid"></strong></p>
        <p class="boh-hint" data-out="paid-detail"></p>

        <div class="boh-actions">
          <button type="button" class="btn btn--solid" data-save-open>Save this wedding</button>
          <button type="button" class="boh-link" data-reset>Start again</button>
        </div>

        <div class="boh-save" data-save hidden>
          <label for="s-couple">Couple's names</label>
          <input id="s-couple" type="text" maxlength="60" autocomplete="off" placeholder="e.g. Katie and Chris" />
          <label for="s-date">Wedding date</label>
          <input id="s-date" type="text" maxlength="30" autocomplete="off" placeholder="e.g. 18 December 2027" />
          <div class="boh-actions">
            <button type="button" class="btn btn--solid" data-save-do>Save</button>
            <button type="button" class="boh-link" data-save-cancel>Cancel</button>
          </div>
        </div>
        <p class="boh-saved-note" data-out="saved-note" role="status"></p>
      </section>
    </div>

    <!-- ============ Folded away until needed ============ -->
    <div class="boh-more container">
      <details class="boh-fold" data-fold="invoice">
        <summary><span>Check an invoice</span><span class="boh-fold__value" data-out="invoice-summary"></span></summary>
        <div class="boh-fold__body">
          {INVOICES.map((v) => (
            <div class="boh-invoice" data-invoice={v.id}>
              <div>
                <label for={`inv-${v.id}`}>{v.label}</label>
                <p class="boh-hint" data-out={`${v.id}-expected`}></p>
              </div>
              <div class="boh-money"><span>£</span><input id={`inv-${v.id}`} name={`inv-${v.id}`} type="text" inputmode="decimal" autocomplete="off" placeholder="0.00" /></div>
              <p class="boh-verdict" data-out={`${v.id}-verdict`} role="status"></p>
            </div>
          ))}
        </div>
      </details>

      <details class="boh-fold" data-fold="workings">
        <summary><span>How this is worked out</span></summary>
        <div class="boh-fold__body">
          <div class="boh-table-wrap">
            <table class="boh-table">
              <thead><tr><th scope="col"></th><th scope="col">Couple pays</th><th scope="col">{rates.suppliers.fts}</th><th scope="col">{rates.suppliers.sd}</th><th scope="col">{rates.suppliers.lodge}</th></tr></thead>
              <tbody data-out="rows"></tbody>
              <tfoot data-out="foot"></tfoot>
            </table>
          </div>
          <p class="boh-hint">{rates.suppliers.fts} is not VAT registered, so its figures are shown without VAT. Everything else includes VAT. What the Lodge keeps is before drinks, styling, staff and its other costs.</p>
        </div>
      </details>

      <details class="boh-fold" data-fold="saved">
        <summary><span>Saved weddings</span><span class="boh-fold__value" data-out="saved-count"></span></summary>
        <div class="boh-fold__body">
          <p class="boh-hint" data-out="saved-empty">Nothing saved yet. Use "Save this wedding" to start a running total.</p>
          <div data-saved-wrap hidden>
            <div class="boh-chips boh-chips--small" data-out="filter"></div>
            <dl class="boh-three boh-three--totals">
              <div><dt>{rates.suppliers.fts}</dt><dd data-out="t-fts"></dd></div>
              <div><dt>{rates.suppliers.sd}</dt><dd data-out="t-sd"></dd></div>
              <div class="boh-three__lodge"><dt>{rates.suppliers.lodge} keeps</dt><dd data-out="t-lodge"></dd></div>
            </dl>
            <p class="boh-hint" data-out="t-note"></p>
            <div class="boh-table-wrap">
              <table class="boh-table boh-table--saved">
                <thead><tr><th scope="col">Wedding</th><th scope="col">{rates.suppliers.fts}</th><th scope="col">{rates.suppliers.sd}</th><th scope="col">{rates.suppliers.lodge}</th><th scope="col">Invoices</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody data-out="saved-rows"></tbody>
              </table>
            </div>
            <div class="boh-actions">
              <button type="button" class="boh-link" data-download>Download as a spreadsheet</button>
            </div>
            <p class="boh-hint">Saved on this computer, in this browser only. Download the spreadsheet now and then to keep a copy.</p>
          </div>
        </div>
      </details>
    </div>
  </main>
</Base>

<script type="application/json" id="boh-rates" set:html={JSON.stringify(rates)} />

<script>
  const R = JSON.parse(document.getElementById("boh-rates")!.textContent!);
  const YEARS: string[] = Object.keys(R.years);
  const TYPES: string[] = R.guestTypes.map((g: any) => g.id);
  const KEY = "styal-boh-weddings";
  const form = document.getElementById("boh") as HTMLFormElement;
  const $ = (name: string) => document.querySelector<HTMLElement>(`[data-out="${name}"]`)!;

  // money: whole pounds when it is whole, pence when it is not, a proper minus sign when negative
  const money = (n: number) => {
    const v = Math.round(n * 100) / 100;
    const s = "£" + Math.abs(v).toLocaleString("en-GB", { minimumFractionDigits: Number.isInteger(v) ? 0 : 2, maximumFractionDigits: 2 });
    return v < 0 ? "−" + s : s;
  };
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

  const thisYear = String(new Date().getFullYear());
  const blank = () => ({ year: YEARS.includes(thisYear) ? thisYear : YEARS[0], day: R.dayTypes[1].id as string, adultDay: 0, childDay: 0, adultEve: 0, childEve: 0 });
  const state: any = blank();
  const INV = ["ftsBase", "ftsExtra", "sdBase", "sdExtra"] as const;
  type Inv = Record<(typeof INV)[number], string>;
  const noInvoices = (): Inv => ({ ftsBase: "", ftsExtra: "", sdBase: "", sdExtra: "" });
  let invoices: Inv = noInvoices();
  // Follow the Smoke is not VAT registered. Its rates in the data file include VAT, so VAT comes off here, per head, to the penny.
  const p2 = (n: number) => Math.round(n * 100) / 100;
  const ftsRate = (incVat: number) => p2(incVat / (1 + R.ftsVatRate));
  let openId: string | null = null;      // the saved wedding currently open, if any
  let filter = "all";

  // ---- start from a link, if one was used ----
  const q = new URLSearchParams(location.search);
  if (YEARS.includes(q.get("y") ?? "")) state.year = q.get("y");
  if (R.dayTypes.some((d: any) => d.id === q.get("d"))) state.day = q.get("d");
  for (const [p, k] of [["a", "adultDay"], ["c", "childDay"], ["ea", "adultEve"], ["ec", "childEve"]]) {
    const n = parseInt(q.get(p) ?? "", 10);
    if (Number.isFinite(n)) state[k] = Math.max(0, Math.min(300, n));
  }

  // ---- the sums: one place, used by the screen, the invoice check and the saved list ----
  function work(s: any) {
    const y = R.years[s.year], inc = R.includedGuests;
    const rows: { label: string; detail: string; paid: number; fts: number; sd: number; lodge: number }[] = [];
    const add = (label: string, detail: string, paid: number, fts: number, sd: number) => rows.push({ label, detail, paid, fts: p2(fts), sd: p2(sd), lodge: p2(paid - p2(fts) - p2(sd)) });
    add(`Package for ${inc} guests`, `${R.dayTypes.find((d: any) => d.id === s.day).label}, ${s.year}`, y.package[s.day], inc * ftsRate(y.package.ftsPerHead), inc * y.package.sdPerHead);
    for (const g of R.guestTypes) {
      const n = s[g.id], x = y.extras[g.id];
      if (n > 0) add(`${g.label}: ${g.child ? "children" : "adults"}`, `${n} at ${money(x.price)}`, n * x.price, n * ftsRate(x.fts), n * x.sd);
    }
    const sum = (k: "paid" | "fts" | "sd" | "lodge", from = 0) => p2(rows.slice(from).reduce((t, r) => t + r[k], 0));
    return { rows, paid: sum("paid"), fts: sum("fts"), sd: sum("sd"), lodge: sum("lodge"), extras: sum("paid", 1),
      ftsBase: rows[0].fts, ftsExtra: sum("fts", 1), sdBase: rows[0].sd, sdExtra: sum("sd", 1) };
  }

  // what each invoice should say, in words
  function expected(s: any, id: (typeof INV)[number]) {
    const y = R.years[s.year], fts = id.startsWith("fts");
    if (id.endsWith("Base")) return `${R.includedGuests} guests at ${money(fts ? ftsRate(y.package.ftsPerHead) : y.package.sdPerHead)}`;
    const bits: string[] = [];
    for (const g of R.guestTypes) {
      const n = s[g.id], rate = fts ? ftsRate(y.extras[g.id].fts) : y.extras[g.id].sd;
      if (n > 0 && rate > 0) bits.push(`${plural(n, g.child ? "child" : "adult", g.child ? "children" : "adults")} ${g.id.endsWith("Eve") ? "in the evening" : "in the day"} at ${money(rate)}`);
    }
    return bits.join(", ");
  }

  const parseMoney = (v: string) => { const n = parseFloat(v.replace(/[£,\s]/g, "")); return Number.isFinite(n) && n >= 0 ? Math.round(n * 100) / 100 : null; };
  function verdict(entered: string, want: number) {
    const n = parseMoney(entered);
    if (n === null) return { text: "", state: "" };
    const diff = Math.round((n - want) * 100) / 100;
    if (diff === 0) return { text: "Matches.", state: "ok" };
    return { text: `${money(Math.abs(diff))} ${diff > 0 ? "more" : "less"} than expected.`, state: "off" };
  }

  // ---- saved weddings (this browser only) ----
  type Saved = { id: string; couple: string; date: string; s: any; inv: Inv; at: string };
  const load = (): Saved[] => { try { const v = JSON.parse(localStorage.getItem(KEY) ?? "[]"); return Array.isArray(v) ? v : []; } catch { return []; } };
  const store = (list: Saved[]) => { try { localStorage.setItem(KEY, JSON.stringify(list)); return true; } catch { return false; } };

  function syncInputs() {
    (form.elements.namedItem("year") as RadioNodeList).value = state.year;
    (form.elements.namedItem("day") as RadioNodeList).value = state.day;
    for (const t of TYPES) (form.elements.namedItem(t) as HTMLInputElement).value = String(state[t]);
    for (const k of INV) (document.getElementById(`inv-${k}`) as HTMLInputElement).value = invoices[k];
    if (state.childDay > 0 || state.childEve > 0) showChildren();
  }
  function showChildren() {
    form.querySelectorAll<HTMLElement>("[data-child]").forEach((el) => (el.hidden = false));
    form.querySelector<HTMLElement>("[data-children]")!.hidden = true;
  }

  function cell(tag: string, text: string, cls = "") { const c = document.createElement(tag); c.textContent = text; if (cls) c.className = cls; return c; }

  function render() {
    const w = work(state);
    for (const k of INV) $(k).textContent = money(w[k]);
    $("lodge").textContent = money(w.lodge);
    $("paid").textContent = money(w.paid);
    $("paid-detail").textContent = w.extras > 0 ? `Package ${money(w.rows[0].paid)} and extra guests ${money(w.extras)}.` : `The package, with no extra guests.`;

    // invoice check: an extra-guests invoice only exists when there are extra guests for that supplier
    const st = checkAll(state, invoices);
    for (const k of INV) {
      const row = document.querySelector<HTMLElement>(`[data-invoice="${k}"]`)!;
      row.hidden = k.endsWith("Extra") && w[k] === 0;
      $(`${k}-expected`).textContent = `Expected ${money(w[k])}: ${expected(state, k)}.`;
      const v = verdict(invoices[k], w[k]); const el = $(`${k}-verdict`); el.textContent = v.text; el.dataset.state = v.state;
    }
    $("invoice-summary").textContent = st.checked ? st.text : "";

    // workings
    $("rows").replaceChildren(...w.rows.map((r) => {
      const tr = document.createElement("tr");
      const th = cell("th", r.label); th.setAttribute("scope", "row"); th.append(cell("small", r.detail));
      tr.append(th, cell("td", money(r.paid)), cell("td", money(r.fts)), cell("td", money(r.sd)), cell("td", money(r.lodge)));
      return tr;
    }));
    const ft = document.createElement("tr"); const fh = cell("th", "Total"); fh.setAttribute("scope", "row");
    ft.append(fh, cell("td", money(w.paid)), cell("td", money(w.fts)), cell("td", money(w.sd)), cell("td", money(w.lodge)));
    $("foot").replaceChildren(ft);

    document.querySelector<HTMLElement>("[data-save-open]")!.textContent = openId ? "Save changes" : "Save this wedding";
    renderSaved();

    // keep the link in step so a refresh or a bookmark comes back to the same wedding
    const u = new URLSearchParams({ y: state.year, d: state.day });
    for (const [p, k] of [["a", "adultDay"], ["c", "childDay"], ["ea", "adultEve"], ["ec", "childEve"]]) if (state[k] > 0) u.set(p, String(state[k]));
    history.replaceState(null, "", `${location.pathname}?${u}`);
  }

  // one line on how a wedding's invoices stand
  function checkAll(s: any, inv: Partial<Inv> | undefined) {
    const w = work(s); let due = 0, ok = 0, off = 0;
    for (const k of INV) {
      if (k.endsWith("Extra") && w[k] === 0) continue;
      due++; const v = verdict(inv?.[k] ?? "", w[k]).state;
      if (v === "ok") ok++; else if (v === "off") off++;
    }
    const checked = ok + off;
    if (off) return { checked, text: `${plural(off, "invoice does", "invoices do")} not match`, state: "off" };
    if (ok === due) return { checked, text: due === 1 ? "Matches" : "All match", state: "ok" };
    if (ok) return { checked, text: `${ok} of ${due} checked`, state: "" };
    return { checked, text: "Not checked", state: "" };
  }
  const invoiceStatus = (x: Saved) => checkAll(x.s, x.inv);

  function renderSaved() {
    const all = load();
    $("saved-count").textContent = all.length ? String(all.length) : "";
    $("saved-empty").hidden = all.length > 0;
    document.querySelector<HTMLElement>("[data-saved-wrap]")!.hidden = all.length === 0;
    if (!all.length) return;
    const yrs = [...new Set(all.map((x) => x.s.year))].sort();
    if (filter !== "all" && !yrs.includes(filter)) filter = "all";
    $("filter").replaceChildren(...(yrs.length > 1 ? ["all", ...yrs] : []).map((f) => {
      const b = document.createElement("button"); b.type = "button"; b.className = "boh-pill"; b.textContent = f === "all" ? "All years" : f;
      b.dataset.filter = f; b.setAttribute("aria-pressed", String(filter === f)); return b;
    }));
    const list = all.filter((x) => filter === "all" || x.s.year === filter);
    const tot = { fts: 0, sd: 0, lodge: 0 };
    $("saved-rows").replaceChildren(...list.map((x) => {
      const w = work(x.s); tot.fts += w.fts; tot.sd += w.sd; tot.lodge += w.lodge;
      const tr = document.createElement("tr"); if (x.id === openId) tr.className = "is-open";
      const th = cell("th", x.couple || "Unnamed wedding"); th.setAttribute("scope", "row");
      th.append(cell("small", [x.date, `${R.dayTypes.find((d: any) => d.id === x.s.day).label}, ${x.s.year}`].filter(Boolean).join(" · ")));
      const st = invoiceStatus(x); const inv = cell("td", st.text); inv.dataset.state = st.state;
      const act = document.createElement("td"); act.className = "boh-rowact";
      const open = cell("button", "Open", "boh-link"); (open as HTMLButtonElement).type = "button"; open.dataset.open = x.id;
      const del = cell("button", "Remove", "boh-link"); (del as HTMLButtonElement).type = "button"; del.dataset.remove = x.id;
      act.append(open, del);
      tr.append(th, cell("td", money(w.fts)), cell("td", money(w.sd)), cell("td", money(w.lodge)), inv, act);
      return tr;
    }));
    $("t-fts").textContent = money(tot.fts); $("t-sd").textContent = money(tot.sd); $("t-lodge").textContent = money(tot.lodge);
    $("t-note").textContent = `Running totals for ${plural(list.length, "wedding", "weddings")}${filter === "all" ? "" : ` in ${filter}`}.`;
  }

  // ---- events ----
  form.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "year" || t.name === "day") state[t.name] = t.value;
    else if (TYPES.includes(t.name)) { const n = parseInt(t.value, 10); state[t.name] = Number.isFinite(n) ? Math.max(0, Math.min(300, n)) : 0; t.value = String(state[t.name]); }
    render();
  });
  form.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-step],[data-children]");
    if (!el) return;
    if (el.hasAttribute("data-children")) { showChildren(); return; }
    const k = el.dataset.step!; state[k] = Math.max(0, Math.min(300, state[k] + Number(el.dataset.dir)));
    (form.elements.namedItem(k) as HTMLInputElement).value = String(state[k]); render();
  });
  for (const k of INV) document.getElementById(`inv-${k}`)!.addEventListener("input", (e) => { invoices[k] = (e.target as HTMLInputElement).value; render(); });

  const savePanel = document.querySelector<HTMLElement>("[data-save]")!;
  const note = (text: string) => { $("saved-note").textContent = text; };
  document.querySelector("[data-save-open]")!.addEventListener("click", () => {
    const cur = openId ? load().find((x) => x.id === openId) : null;
    (document.getElementById("s-couple") as HTMLInputElement).value = cur?.couple ?? "";
    (document.getElementById("s-date") as HTMLInputElement).value = cur?.date ?? "";
    savePanel.hidden = false; note(""); (document.getElementById("s-couple") as HTMLInputElement).focus();
  });
  document.querySelector("[data-save-cancel]")!.addEventListener("click", () => { savePanel.hidden = true; });
  document.querySelector("[data-save-do]")!.addEventListener("click", () => {
    const list = load();
    const entry: Saved = {
      id: openId ?? `w${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,
      couple: (document.getElementById("s-couple") as HTMLInputElement).value.trim().slice(0, 60),
      date: (document.getElementById("s-date") as HTMLInputElement).value.trim().slice(0, 30),
      s: { ...state }, inv: { ...invoices }, at: new Date().toISOString(),
    };
    const i = list.findIndex((x) => x.id === entry.id);
    if (i >= 0) list[i] = entry; else list.push(entry);
    if (!store(list)) { note("This browser would not save it. Private browsing can block saving."); return; }
    openId = entry.id; savePanel.hidden = true;
    note(`Saved${entry.couple ? ` for ${entry.couple}` : ""}. See "Saved weddings" below for the running totals.`);
    render();
  });
  document.querySelector("[data-reset]")!.addEventListener("click", () => {
    Object.assign(state, blank()); invoices = noInvoices(); openId = null; savePanel.hidden = true; note("");
    syncInputs(); render(); window.scrollTo({ top: 0, behavior: "smooth" });
  });

  document.querySelector(".boh-more")!.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-open],[data-remove],[data-confirm],[data-keep],[data-filter],[data-download]");
    if (!el) return;
    if (el.dataset.filter) { filter = el.dataset.filter; renderSaved(); return; }
    if (el.dataset.open) {
      const x = load().find((v) => v.id === el.dataset.open); if (!x) return;
      Object.assign(state, blank(), x.s); invoices = { ...noInvoices(), ...Object.fromEntries(INV.map((k) => [k, x.inv?.[k] ?? ""])) } as Inv; openId = x.id; savePanel.hidden = true;
      note(`Opened ${x.couple || "the saved wedding"}. Change anything, then "Save changes".`);
      syncInputs(); render(); window.scrollTo({ top: 0, behavior: "smooth" }); return;
    }
    if (el.dataset.remove) {   // ask on the row itself, never in a pop-up
      const td = el.parentElement!; td.replaceChildren();
      const yes = cell("button", "Remove for good", "boh-link boh-link--warn"); (yes as HTMLButtonElement).type = "button"; yes.dataset.confirm = el.dataset.remove;
      const no = cell("button", "Keep", "boh-link"); (no as HTMLButtonElement).type = "button"; no.dataset.keep = "1";
      td.append(yes, no); return;
    }
    if (el.dataset.keep) { renderSaved(); return; }
    if (el.dataset.confirm) {
      store(load().filter((v) => v.id !== el.dataset.confirm)); if (openId === el.dataset.confirm) openId = null;
      render(); return;
    }
    if (el.hasAttribute("data-download")) {
      const esc = (v: unknown) => { const s = String(v ?? ""); return /^[=+\-@]/.test(s) ? `"'${s.replace(/"/g, '""')}"` : `"${s.replace(/"/g, '""')}"`; };
      const head = ["Couple", "Wedding date", "Year", "Day", "Extra adult day", "Extra child day", "Adult evening", "Child evening", "Couple paid", "Follow the Smoke package (no VAT)", "Follow the Smoke extra guests (no VAT)", "Special Days package", "Special Days extra guests", "Styal Lodge keeps", "Invoices", "Saved"];
      const lines = load().map((x) => { const w = work(x.s); return [x.couple, x.date, x.s.year, R.dayTypes.find((d: any) => d.id === x.s.day).label, x.s.adultDay, x.s.childDay, x.s.adultEve, x.s.childEve, w.paid.toFixed(2), w.ftsBase.toFixed(2), w.ftsExtra.toFixed(2), w.sdBase.toFixed(2), w.sdExtra.toFixed(2), w.lodge.toFixed(2), invoiceStatus(x).text, x.at.slice(0, 10)].map(esc).join(","); });
      const blob = new Blob(["﻿" + [head.map(esc).join(","), ...lines].join("\r\n")], { type: "text/csv;charset=utf-8" });
      const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = `styal-lodge-winter-weddings-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }
  });

  syncInputs(); render();
</script>

