---
/*
  Feasting.astro — single-page, full-bleed hero for the Feasting section.
  Cropped to frame the food board (with the table setting above); the building
  at the very top of the photo is intentionally out of frame.
  "Eat beautifully" sits top-left in oat (background colour), clear of the header.
*/
import { Image } from "astro:assets";
import feasting from "../assets/feasting.jpg";
---
<section id="feasting" class="feasting">
  <Image
    class="feasting__img"
    src={feasting}
    alt="A sharing board of feast food carried to an outdoor table at Styal Lodge"
    widths={[800, 1200, 1600, 2000, 2181]}
    sizes="100vw"
    loading="lazy"
  />
  <p class="feasting__tagline"><em>Eat beautifully</em></p>
</section>

<style>
  .feasting {
    position: relative;
    width: 100vw; margin-left: calc(50% - 50vw);   /* full-bleed */
    height: 100svh;                                 /* one page */
    overflow: hidden;
  }
  .feasting__img {
    width: 100%; height: 100%; object-fit: cover;
    object-position: center 74%;                    /* frame the food board */
    display: block;
  }
  .feasting__tagline {
    position: absolute;
    top: calc(var(--header-h) + 1cm);
    left: var(--gutter);
    margin: 0;
    color: var(--on-dark);
    font-style: italic;
    font-size: clamp(1.7rem, 1rem + 3.6vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 1px 18px rgba(20, 18, 16, .45);
  }
</style>
