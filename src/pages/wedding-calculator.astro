  .calc-line { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--hairline); }
  .calc-line dt { font-size: var(--text-sm); line-height: 1.35; }
  .calc-line dt small, .calc-schedule small { display: block; font-size: var(--text-xs); color: var(--stone); }
  .calc-line dd { font-size: var(--text-sm); white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
  .calc-plan { margin-top: 1.5rem; display: grid; gap: .6rem; }
  .calc-schedule { list-style: none; padding: 0; margin: 0; counter-reset: pay; }
  .calc-schedule li { counter-increment: pay; display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: .85rem; padding: .7rem 0; border-bottom: 1px solid var(--hairline); }
  .calc-schedule li::before { content: counter(pay); width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border: 1px solid var(--taupe); border-radius: 50%; font-size: var(--text-xs); color: var(--stone); align-self: center; }
  .calc-schedule__what { font-size: var(--text-sm); line-height: 1.35; }
  .calc-schedule__amt { font-size: var(--text-base); white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
  .calc-actions { margin-top: 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .calc-actions .btn { letter-spacing: 0.01em; padding-inline: 1em; border-radius: 999px; }
  .calc-actions .calc-link { grid-column: 1 / -1; justify-self: center; margin-top: 0; }
  .calc-smallprint { margin-top: 1.1rem; font-size: var(--text-xs); color: var(--stone); line-height: 1.55; }

  /* ---- phone total bar ---- */
  .calc-bar { display: none; }

  /* ---- tablet and phone ---- */
  @media (max-width: 64em) {
    .calc { grid-template-columns: 1fr; }
    .calc-summary { position: static; max-height: none; overflow: visible; }
    .calc-next--link { display: inline-flex; }
    .calc-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; gap: 1rem;
      padding: .9rem var(--gutter) calc(.9rem + env(safe-area-inset-bottom)); background: var(--surface-dark); color: var(--on-dark); text-decoration: none;
      transition: transform .3s ease;
    }
    .calc-bar.is-hidden { transform: translateY(110%); }
    .calc-bar__label { font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--on-dark-muted); }
    .calc-bar__total { font-size: var(--text-lg); font-variant-numeric: lining-nums; }
    .calc-bar__go { font-size: var(--text-xs); letter-spacing: 0.04em; border: 1px solid rgba(244, 241, 234, .4); border-radius: 999px; padding: .35em 1em; }
    .calc-page { padding-bottom: calc(var(--stack-gap) + 4.5rem); }
  }
  @media (max-width: 40em) {
    .calc-cards { grid-template-columns: 1fr; }
    .calc-step > summary { grid-template-columns: auto 1fr auto; }
    .calc-step__value { grid-column: 2 / 3; grid-row: 2; text-align: left; }
    .calc-step[open] .calc-step__value { display: none; }
    .calc-step__chev { grid-row: 1; grid-column: 3; }
    .calc-actions { grid-template-columns: 1fr; }
    .calc-stepper__ctrl input { width: 2.8rem; }
  }

  /* ---- print: a clean one-page estimate ---- */
  @media print {
    @page { margin: 16mm; }
    .site-header, .site-footer, .skip-link, .calc-steps, .calc-bar, .calc-actions, .calc-sample, .calc-mast__lead, .calc-mast .eyebrow { display: none !important; }
    body { background: #fff; }
    .calc-page { padding: 0; }
    .calc-mast { padding-bottom: 8mm; }
    .calc-mast__logo { height: 26mm; margin-bottom: 6mm; }
    .calc-mast .display { font-size: 20pt; }
    .calc { display: block; }
    .calc-summary { position: static; border: 0; background: none; padding: 0; max-height: none; overflow: visible; }
    .calc-summary__total { font-size: 34pt; }
