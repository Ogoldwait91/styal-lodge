---
/*
  Wedding calculator — a standalone page for coordinators to use with couples.
  Every price, option and payment plan comes from src/data/pricing.json.
  Nothing here needs editing when prices change.
*/
import Base from "../layouts/Base.astro";
import pricing from "../data/pricing.json";

const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const fmt = (n: number) => "£" + (Number.isInteger(n) ? n.toLocaleString("en-GB") : n.toFixed(2));
const steps = ["Your date", "Your guests", "Payment plan"];
// While the rest of the site is unfinished the calculator stands alone: no menu, no footer, no links out.
// Set this to false to put it back inside the site once the site is ready.
const STANDALONE = true;
const onePlan = pricing.payment.plans.length < 2;   // nothing to choose between, so the step is hidden
---
<Base
  title="Wedding calculator — Styal Lodge"
  description="See venue prices for your date at Styal Lodge and how the payments are spread."
  showFloatingCta={false}
  standalone={STANDALONE}
>
  <div class:list={["calc-page", STANDALONE && "calc-page--standalone"]}>
    <header class="calc-mast container">
      <img class="calc-mast__logo" src="/logo-dark.svg" width="971" height="617" alt="Styal Lodge — Wedding Venue, Cheshire" data-hero-wordmark />
      <p class="eyebrow">Plan your day</p>
      <h1 class="display">Wedding <em>calculator</em></h1>
      <p class="calc-mast__lead">Choose your season, date and guest numbers to see the price for your day.</p>
      <fieldset class="calc-season">
        <legend class="visually-hidden">Season</legend>
        {[pricing.summer, pricing.winter].map((sn, i) => (
          <label class="calc-chip calc-chip--priced calc-chip--season">
            <input type="radio" name="season" value={i === 0 ? "summer" : "winter"} />
            <span><span>{sn.label}</span><small>{MONTHS[sn.months[0] - 1]} to {MONTHS[sn.months[sn.months.length - 1] - 1]}</small></span>
          </label>
        ))}
      </fieldset>
    </header>

    <div class="calc container">
      <form class="calc-steps" id="calc" novalidate>

        <!-- 1. Date -->
        <details class="calc-step" name="calc-step" open>
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[0]}</span>
            <span class="calc-step__value" data-out="s-date"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <fieldset class="calc-field">
              <legend>Year</legend>
              <div class="calc-chips">
                {pricing.years.map((y) => (
                  <label class="calc-chip"><input type="radio" name="year" value={y} /><span>{y}</span></label>
                ))}
              </div>
            </fieldset>
            <div class="calc-field">
              <label for="f-month">Month</label>
              <div class="calc-select">
                <select id="f-month" name="month">
                </select>
              </div>
            </div>
            <div class="calc-field">
              <label for="f-date">Date <span class="calc-opt">Optional</span></label>
              <div class="calc-select">
                <select id="f-date" name="date"></select>
              </div>
              <p class="calc-hint" data-out="date-note"></p>
            </div>
            <fieldset class="calc-field">
              <legend>Day of the week</legend>
              <div class="calc-chips">
                {pricing.dayTypes.map((d) => (
                  <label class="calc-chip calc-chip--priced"><input type="radio" name="dayType" value={d.id} /><span><span>{d.short}</span><small data-chip-price={d.id}></small></span></label>
                ))}
              </div>
            </fieldset>
            <label class="calc-check calc-check--solo">
              <input type="checkbox" name="holiday" value="1" />
              <span class="calc-check__box" aria-hidden="true"></span>
              <span class="calc-check__text">
                <span class="calc-check__name">Bank or public holiday</span>
                <span class="calc-check__note" data-out="holiday-note"></span>
              </span>
            </label>
            <p class="calc-price-line"><span data-out="hire-label"></span> <strong data-out="hire-inline"></strong> <span data-out="season-inline"></span></p>
            <button type="button" class="calc-next" data-next></button>
          </div>
        </details>

        <!-- 2. Guests (hidden when guest numbers do not change the price) -->
        <details class="calc-step" name="calc-step" data-guests>
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[1]}</span>
            <span class="calc-step__value" data-out="s-guests"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            {[
              { id: "day", label: "Day guests", hint: "Ceremony, wedding breakfast and evening", mode: undefined },
              { id: "evening", label: "Evening-only guests", hint: "Joining for the party", mode: undefined },
            ].map((g) => (
              <div class="calc-stepper" data-mode={g.mode}>
                <div>
                  <label for={`f-${g.id}`}>{g.label}</label>
                  <p class="calc-hint">{g.hint}</p>
                </div>
                <div class="calc-stepper__ctrl">
                  <button type="button" data-step={g.id} data-dir="-1" aria-label={`Fewer: ${g.label}`}>−</button>
                  <input id={`f-${g.id}`} name={g.id} type="number" inputmode="numeric" min="0" step="1" />
                  <button type="button" data-step={g.id} data-dir="1" aria-label={`More: ${g.label}`}>+</button>
                </div>
              </div>
            ))}
            <p class="calc-hint" data-out="guest-note"></p>
            <button type="button" class="calc-next" data-next></button>
          </div>
        </details>

        <!-- 6. Payment plan -->
        <details class="calc-step" name="calc-step" hidden={onePlan}>
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[2]}</span>
            <span class="calc-step__value" data-out="s-plan"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <fieldset class="calc-field">
              <legend class="visually-hidden">Payment plan</legend>
              <div class="calc-cards calc-cards--slim">
                {pricing.payment.plans.map((p) => (
                  <label class="calc-card">
                    <input type="radio" name="plan" value={p.id} />
                    <span class="calc-card__name">{p.name}</span>
                    <span class="calc-card__blurb">{p.summary}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <button type="button" class="calc-next" data-next></button>
          </div>
        </details>

        <!-- Your details (optional): personalises the estimate -->
        <details class="calc-step" name="calc-step">
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">Your details</span>
            <span class="calc-step__value" data-out="s-names"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <div class="calc-field">
              <label for="f-couple">Couple's names <span class="calc-opt">Optional</span></label>
              <input class="calc-text" type="text" id="f-couple" name="couple" maxlength="80" autocomplete="off" placeholder="For example, Katie and Chris" />
            </div>
            <div class="calc-field">
              <label for="f-coordinator">Your coordinator <span class="calc-opt">Optional</span></label>
              <input class="calc-text" type="text" id="f-coordinator" name="coordinator" maxlength="60" autocomplete="off" placeholder="Coordinator's name" />
              <p class="calc-hint">Both names appear on the estimate. The coordinator's name is remembered on this device.</p>
            </div>
          </div>
        </details>

        <p class="calc-note" data-out="season-note"></p>

        <!-- The end of the form: a clear finishing step -->
        <div class="calc-finish" data-finish>
          <div class="calc-finish__todo">
            <button type="button" class="btn btn--solid calc-finish__btn" data-finish-btn>Finish estimate</button>
            <p class="calc-hint">You can still change anything afterwards.</p>
          </div>
          <div class="calc-finish__done" hidden>
            <p class="calc-finish__title">Your estimate is ready<span data-out="done-for"></span>.</p>
            <p class="calc-hint">Tap any section above to change it. The estimate updates straight away.</p>
            <div class="calc-finish__actions">
              <button type="button" class="btn btn--solid" data-print>Print or save as PDF</button>
              <button type="button" class="btn btn--ghost" data-reset>Start a new estimate</button>
            </div>
          </div>
        </div>
      </form>

      <!-- Estimate -->
      <aside class="calc-summary" id="estimate" aria-live="polite">
        <p class="eyebrow" data-out="heading">Your estimate</p>
        <p class="calc-summary__for" data-out="for"></p>
        <p class="calc-summary__total" data-out="total"></p>
        <p class="calc-summary__per" data-out="per-guest"></p>
        <p class="calc-summary__scope" data-out="scope"></p>
        <p class="calc-summary__context" data-out="context"></p>

        <dl class="calc-lines" data-out="lines"></dl>

        <div class="calc-plan">
          <p class="eyebrow">{onePlan ? "Payment plan · sample breakdown" : (<Fragment>Payment plan · <span data-out="plan-name"></span></Fragment>)}</p>
          {onePlan && <span data-out="plan-name" hidden></span>}
          <ol class="calc-schedule" data-out="schedule"></ol>
          <p class="calc-hint" data-out="plan-note"></p>
        </div>

        <div class="calc-actions">
          {!STANDALONE && <a class="btn btn--solid" href="/book-a-visit">Book a visit</a>}
          <button type="button" class:list={["btn", STANDALONE ? "btn--solid calc-actions__wide" : "btn--ghost"]} data-print>Print or save as PDF</button>
          <div class="calc-actions__links">
            <button type="button" class="calc-link" data-copy>Copy a link to this estimate</button>
            <button type="button" class="calc-link" data-reset>Start again</button>
          </div>
        </div>

        <p class="calc-smallprint" data-out="min-note"></p>
        <p class="calc-smallprint">
          <span data-out="prepared"></span>
          An estimate, not a quotation. All rates include VAT and are subject to change; prices and dates are confirmed in your contract.

        </p>
      </aside>
    </div>

    {STANDALONE && <p class="calc-foot container">Styal Lodge · Station Road, Styal, Cheshire SK9 4JN</p>}

    <!-- Phone: running total pinned to the bottom -->
    <a class="calc-bar" href="#estimate" data-bar>
      <span class="calc-bar__label" data-out="bar-label">Your estimate</span>
      <span class="calc-bar__total" data-out="bar-total"></span>
      <span class="calc-bar__go">View</span>
    </a>
  </div>

  <script type="application/json" id="calc-pricing" set:html={JSON.stringify(pricing)} />
</Base>

<script>
  const P = JSON.parse(document.getElementById("calc-pricing")!.textContent!);
  const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const form = document.getElementById("calc") as HTMLFormElement;
  const $ = (k: string) => document.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
  const money = (n: number) => "£" + (Number.isInteger(n) ? n.toLocaleString("en-GB") : n.toLocaleString("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const pounds = (n: number) => "£" + Math.round(n).toLocaleString("en-GB");
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const longDate = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
  const monthYear = (d: Date) => d.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const FEAST = P.summer.feasting;   // summer catering, priced per day guest

  // ---------- state ----------
  const years: number[] = P.years;
  const firstYear = years.find((y) => y > today.getFullYear()) ?? years[years.length - 1];
  const state: any = {
    date: "", year: firstYear, month: 6, dayType: "sat", holiday: false,
    day: P.guests.defaultDay, evening: P.guests.defaultEvening,
    plan: P.payment.plans[0].id,
    couple: "", coordinator: "",
  };
  const DEFAULTS = JSON.parse(JSON.stringify(state));
  let finished = false;
  const clean = (v: string | null, max: number) => (v ?? "").replace(/[\u0000-\u001f<>]/g, "").trim().slice(0, max);
  try { state.coordinator = clean(localStorage.getItem("styal-calc-coordinator"), 60); } catch { /* storage unavailable: nothing to remember */ }

  // restore from a shared link
  const q = new URLSearchParams(location.search);
  const has = (list: any[], id: string | null) => !!id && list.some((x) => String(x.id) === id);
  if (q.get("y") && years.includes(Number(q.get("y")))) state.year = Number(q.get("y"));
  if (q.get("m") && +q.get("m")! >= 1 && +q.get("m")! <= 12) state.month = +q.get("m")!;
  if (has(P.dayTypes, q.get("d"))) state.dayType = q.get("d");
  state.holiday = q.get("h") === "1";
  for (const [key, param] of [["day", "g"], ["evening", "e"]] as const) {
    const v = q.get(param); if (v !== null && /^\d{1,3}$/.test(v)) state[key] = +v;
  }
  if (has(P.payment.plans, q.get("plan"))) state.plan = q.get("plan");
  if (q.get("date") && /^\d{4}-\d{2}-\d{2}$/.test(q.get("date")!)) state.date = q.get("date");
  if (q.get("for")) state.couple = clean(q.get("for"), 80);
  if (q.get("by")) state.coordinator = clean(q.get("by"), 60);

  // ---------- helpers ----------
  // Bank holidays in England, worked out for any year (one-off extra holidays are not included).
  function bankHolidays(year: number): Record<string, string> {
    const out: Record<string, string> = {};
    const add = (d: Date, name: string) => (out[iso(d)] = name);
    const shift = (d: Date, n: number) => { const r = new Date(d); r.setDate(r.getDate() + n); return r; };
    const firstMon = (m: number) => { const d = new Date(year, m, 1); return shift(d, (8 - d.getDay()) % 7); };
    const lastMon = (m: number) => { const d = new Date(year, m + 1, 0); return shift(d, -((d.getDay() + 6) % 7)); };
    const ny = new Date(year, 0, 1); add(ny.getDay() === 6 ? shift(ny, 2) : ny.getDay() === 0 ? shift(ny, 1) : ny, "New Year's Day");
    const a = year % 19, b = Math.floor(year / 100), c = year % 100, d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3);
    const h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
    const easter = new Date(year, Math.floor((h + l - 7 * m + 114) / 31) - 1, ((h + l - 7 * m + 114) % 31) + 1);
    add(shift(easter, -2), "Good Friday"); add(shift(easter, 1), "Easter Monday");
    add(firstMon(4), "the early May bank holiday"); add(lastMon(4), "the spring bank holiday"); add(lastMon(7), "the summer bank holiday");
    const xmas = new Date(year, 11, 25), wd = xmas.getDay();
    add(wd === 6 || wd === 0 ? shift(xmas, 2) : xmas, "Christmas Day");
    add(wd === 5 || wd === 6 ? shift(xmas, 3) : shift(xmas, 1), "Boxing Day");
    return out;
  }
  const holidayName = (dateIso: string) => (dateIso ? bankHolidays(Number(dateIso.slice(0, 4)))[dateIso] ?? "" : "");

  const isWinter = () => P.winter.months.includes(state.month);
  const parseDate = (s: string) => { const [y, m, d] = s.split("-").map(Number); return new Date(y, m - 1, d); };
  const addMonths = (d: Date, n: number) => { const r = new Date(d); const day = r.getDate(); r.setDate(1); r.setMonth(r.getMonth() + n); r.setDate(Math.min(day, new Date(r.getFullYear(), r.getMonth() + 1, 0).getDate())); return r; };

  function applyDate() {
    if (!state.date) return;
    const d = parseDate(state.date);
    if (isNaN(d.getTime()) || !years.includes(d.getFullYear()) || d < today) { state.date = ""; return; }
    state.year = d.getFullYear(); state.month = d.getMonth() + 1;
    state.dayType = P.dayTypes.find((t: any) => t.days.includes(d.getDay()))?.id ?? state.dayType;
    state.holiday = !!holidayName(state.date);   // an exact date knows whether it is a bank holiday
  }

  function clampGuests() {
    const g = P.guests;
    state.day = Math.min(g.maxDay, Math.max(2, Math.round(state.day || 0)));
    state.evening = Math.min(Math.max(0, Math.round(state.evening || 0)), Math.max(0, g.maxEveningTotal - state.day));
  }

  // ---------- calculation ----------
  function calculate(month: number = state.month, opts: { dayType?: string; holiday?: boolean } = {}) {
    const winter = P.winter.months.includes(month);
    const useDay = opts.dayType ?? state.dayType;
    const useHoliday = opts.holiday ?? state.holiday;
    const dayType = P.dayTypes.find((t: any) => t.id === useDay);
    const lines: { label: string; detail: string; amount: number }[] = [];
    const when = useHoliday ? "Bank holiday" : dayType.short;
    let base = 0; let baseLabel = ""; let priced = true;

    if (winter) {
      const c = P.winter.collection[String(state.year)];
      baseLabel = `Winter collection for ${P.winter.includedGuests} guests`;
      if (!c) priced = false;
      else {
        const peak = useHoliday || P.winter.peakDays.includes(useDay);
        base = peak ? c.peak : c.offPeak;
        lines.push({ label: baseLabel, detail: `${when}, ${state.year}. Food, drinks and styling included`, amount: base });
        const extra = Math.max(0, state.day - P.winter.includedGuests);
        if (extra > 0) lines.push({ label: "Additional day guests", detail: `${extra} at ${money(c.extraDayGuest)}`, amount: extra * c.extraDayGuest });
        if (state.evening > 0) lines.push({ label: "Evening-only guests", detail: `${state.evening} at ${money(c.eveningGuest)}`, amount: state.evening * c.eveningGuest });
      }
    } else {
      const table = P.summer.hire[String(state.year)];
      baseLabel = "Exclusive use of the Lodge";
      if (!table) priced = false;
      else {
        base = table[useHoliday ? P.summer.holidayRate : useDay];
        lines.push({ label: baseLabel, detail: `${when}, ${P.summer.label.toLowerCase().replace("styal", "Styal")} ${state.year}. ${P.summer.hireIncludes}`, amount: base });
        if (FEAST) lines.push({ label: FEAST.name + (FEAST.minimumSpend ? " *" : ""), detail: `${plural(state.day, "guest", "guests")} at ${money(FEAST.perGuest)}. ${FEAST.short}`, amount: state.day * FEAST.perGuest });
        if (FEAST && state.evening > 0) lines.push({ label: "Evening-only guests", detail: `${state.evening} at ${money(FEAST.eveningGuest)}. Evening food`, amount: state.evening * FEAST.eveningGuest });
        const TW = P.summer.tableware;
        if (TW) lines.push({ label: TW.name, detail: `${plural(state.day, "guest", "guests")} at ${money(TW.perGuest)}`, amount: state.day * TW.perGuest });
      }
    }
    lines.forEach((l) => (l.amount = Math.round(l.amount)));   // whole pounds, so the lines always add up to the total
    const total = lines.reduce((s, l) => s + l.amount, 0);
    return { winter, dayType, lines, total, base, baseLabel, priced, when };
  }

  // Sample breakdown: the deposit when you book, then the balance in equal monthly payments,
  // the last one falling the set number of months before the wedding. It assumes booking today.
  function schedule(total: number) {
    const plan = P.payment.plans.find((p: any) => p.id === state.plan) ?? P.payment.plans[0];
    const back = P.payment.finalMonthsBefore;
    const exact = state.date ? parseDate(state.date) : null;
    const wedding = exact ?? new Date(state.year, state.month - 1, 1);
    const fin = new Date(wedding.getFullYear(), wedding.getMonth() - back, 1);
    if (exact) fin.setDate(Math.min(exact.getDate(), new Date(fin.getFullYear(), fin.getMonth() + 1, 0).getDate()));
    const finText = exact ? longDate(fin) : monthYear(fin);
    const n = (fin.getFullYear() - today.getFullYear()) * 12 + fin.getMonth() - today.getMonth();   // monthly payments, starting next month
    const deposit = Math.min(P.payment.deposit, Math.round(total));
    const rest = Math.round(total) - deposit;
    const rows: { label: string; when: string; amount: string }[] = [{ label: "Deposit", when: P.payment.depositWhen, amount: pounds(deposit) }];
    if (rest > 0 && n >= 2) {
      const each = Math.floor(rest / n), last = rest - each * (n - 1);
      const first = new Date(today.getFullYear(), today.getMonth() + 1, 1);
      rows.push({ label: `${n} monthly payments of ${pounds(each)}`, when: `Starting the month after you book: ${monthYear(first)} to ${monthYear(fin)}` + (last !== each ? `. Final payment ${pounds(last)}` : "") + (exact ? `. Paid in full by ${finText}` : ""), amount: pounds(rest) });
    } else if (rest > 0) {
      rows.push({ label: "Remaining balance", when: n === 1 ? `By ${finText}` : "When you book, as your wedding is within two months", amount: pounds(rest) });
    }
    return { plan, rows, note: P.payment.note ?? "" };
  }

  // ---------- render ----------
  // The date list always matches the chosen month and year, so a date that has no price can never be picked.
  function buildDates() {
    const sel = form.elements.namedItem("date") as HTMLSelectElement;
    const hols = bankHolidays(state.year);
    const last = new Date(state.year, state.month, 0).getDate();
    const opts = [new Option("No date yet", "")];
    for (let n = 1; n <= last; n++) {
      const d = new Date(state.year, state.month - 1, n);
      if (d < today) continue;
      const label = d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
      opts.push(new Option(hols[iso(d)] ? `${label} · bank holiday` : label, iso(d)));
    }
    sel.replaceChildren(...opts);
  }

  // The month list only ever holds the months of the chosen season.
  const SEASON_START = { summer: 6, winter: 12 };   // the month shown first when a season is chosen
  const seasonOf = (month: number) => (P.winter.months.includes(month) ? "winter" : "summer");
  function buildMonths() {
    const months = [...P[seasonOf(state.month)].months].sort((a: number, b: number) => a - b);
    (form.elements.namedItem("month") as HTMLSelectElement).replaceChildren(...months.map((m: number) => new Option(MONTHS[m - 1], String(m))));
    document.querySelectorAll<HTMLInputElement>('input[name="season"]').forEach((el) => (el.checked = el.value === seasonOf(state.month)));
  }
  function setSeason(season: "summer" | "winter") {
    if (seasonOf(state.month) === season) return;
    state.month = SEASON_START[season]; state.date = ""; state.holiday = false;
    syncInputs(); render();
  }

  function syncInputs() {
    buildMonths(); buildDates();
    (form.elements.namedItem("month") as HTMLSelectElement).value = String(state.month);
    (form.elements.namedItem("date") as HTMLSelectElement).value = state.date;
    (form.elements.namedItem("holiday") as HTMLInputElement).checked = state.holiday;
    for (const k of ["day", "evening"]) (form.elements.namedItem(k) as HTMLInputElement).value = String(state[k]);
    for (const k of ["year", "dayType", "plan"])
      form.querySelectorAll<HTMLInputElement>(`input[name="${k}"]`).forEach((el) => (el.checked = el.value === String(state[k])));
    (form.elements.namedItem("couple") as HTMLInputElement).value = state.couple;
    (form.elements.namedItem("coordinator") as HTMLInputElement).value = state.coordinator;
  }

  function render() {
    const r = calculate();
    const g = P.guests;
    const season = r.winter ? P.winter : P.summer;
    const hireOnly = !r.winter && !FEAST;   // summer with no catering price: the figure is the building only
    const summerFeast = !r.winter && !!FEAST;
    // guest numbers only matter where they change the price
    const guestStep = form.querySelector<HTMLDetailsElement>("details[data-guests]")!;
    if (hireOnly && guestStep.open) guestStep.open = false;
    guestStep.hidden = hireOnly;

    // each day button carries its own price, so days can be compared at a glance
    document.querySelectorAll<HTMLElement>("[data-chip-price]").forEach((el) => {
      const alt = calculate(state.month, { dayType: el.dataset.chipPrice, holiday: false });
      el.textContent = alt.priced ? pounds(alt.base) : "TBC";
    });
    // show the sections that apply to this season
    document.querySelectorAll<HTMLElement>("[data-mode]").forEach((el) => (el.hidden = el.dataset.mode !== (r.winter ? "winter" : "summer")));

    const exact = state.date ? parseDate(state.date) : null;
    const when = exact ? `${exact.toLocaleDateString("en-GB", { weekday: "long" })} ${longDate(exact)}` : `${r.when} · ${MONTHS[state.month - 1]} ${state.year}`;
    $("date-note").textContent = exact ? `${when}. ${season.label}.` : "Choose a date and the day of the week is set for you.";
    $("s-date").textContent = when;
    $("hire-label").textContent = r.baseLabel;
    $("hire-inline").textContent = r.priced ? pounds(r.base) : "to be confirmed";
    $("season-inline").textContent = `(${season.label})`;
    const hol = holidayName(state.date);
    $("holiday-note").textContent = (hol && state.holiday ? `${longDate(parseDate(state.date))} is ${hol}. ` : "") + (r.winter ? "Charged at the Friday to Sunday rate" : "Charged at the Saturday rate");
    $("s-guests").textContent = state.evening ? `${state.day} day · ${state.evening} evening-only` : `${plural(state.day, "day guest", "day guests")}`;
    $("guest-note").textContent = `The Lodge welcomes up to ${g.maxDay} guests for the wedding breakfast and ${g.maxEveningTotal} in the evening.` +
      (summerFeast ? ` Feasting is ${money(FEAST.perGuest)} per day guest${P.summer.tableware ? `, and crockery, cutlery and linen ${money(P.summer.tableware.perGuest)} per day guest: ${money(FEAST.perGuest + P.summer.tableware.perGuest)} per day guest in total` : ""}. Evening-only guests are ${money(FEAST.eveningGuest)} each, for evening food.` : "") +
      (r.winter && r.priced ? ` The winter collection is priced for ${P.winter.includedGuests} guests. Each additional day guest is ${money(P.winter.collection[String(state.year)].extraDayGuest)} and each evening-only guest is ${money(P.winter.collection[String(state.year)].eveningGuest)}.` : "");
    $("season-note").textContent = r.winter
      ? "Included in the winter collection: food, drinks, essential wedding styling and dedicated coordination."
      : hireOnly ? `Guest numbers do not change the venue hire price. The Lodge welcomes up to ${g.maxDay} guests for the wedding breakfast and ${g.maxEveningTotal} in the evening.`
      : `Venue hire includes fairy lights and a Prosecco toast. Feasting is with Follow the Smoke. Four ways to feast: ${FEAST.styles.join(", ")}. ${FEAST.includes}.`;
    $("s-names").textContent = state.couple || "Optional";
    $("for").textContent = state.couple ? `For ${state.couple}` : "";
    $("done-for").textContent = state.couple ? ` for ${state.couple}` : "";
    $("scope").textContent = !r.priced ? "" : hireOnly ? "Catering, drinks and styling are not included in this figure. They are priced separately."
      : summerFeast ? "Includes a Prosecco toast. All other alcoholic and non-alcoholic drinks are priced separately." : "";

    const summary = document.getElementById("estimate")!;
    summary.classList.toggle("is-unpriced", !r.priced);
    // in summer the figure is the building only, so the panel says so in its heading, not in small print
    summary.classList.toggle("is-hire-only", !r.winter && r.priced);
    const heading = hireOnly ? "Venue hire only" : summerFeast ? "Venue hire and feasting" : "Your estimate";
    $("heading").textContent = heading; $("bar-label").textContent = heading;
    $("context").textContent = `${season.label} · ${when}` + (hireOnly ? "" : ` · ${plural(state.day, "day guest", "day guests")}` + (state.evening ? `, ${state.evening} more in the evening` : ""));

    if (!r.priced) {
      $("total").textContent = "To be confirmed";
      $("bar-total").textContent = "To be confirmed";
      $("per-guest").textContent = `${season.label} prices for ${state.year} have not been released yet. Please ask your coordinator.`;
      $("lines").replaceChildren(); $("schedule").replaceChildren(); $("plan-note").textContent = "";
      $("s-plan").textContent = P.payment.plans.find((p: any) => p.id === state.plan).name; $("plan-name").textContent = $("s-plan").textContent;
    } else {
      const s = schedule(r.total);
      $("s-plan").textContent = s.plan.name;
      $("total").textContent = pounds(r.total);
      $("bar-total").textContent = pounds(r.total);
      $("per-guest").textContent = !r.winter ? "" : `About ${pounds(r.total / Math.max(1, state.day))} per day guest`;
      $("lines").replaceChildren(...r.lines.map((l) => {
        const row = document.createElement("div"); row.className = "calc-line";
        const dt = document.createElement("dt"); dt.textContent = l.label;
        if (l.detail) { const sm = document.createElement("small"); sm.textContent = l.detail; dt.append(sm); }
        const dd = document.createElement("dd"); dd.textContent = pounds(l.amount);
        row.append(dt, dd); return row;
      }));
      $("plan-name").textContent = s.plan.name;
      $("schedule").replaceChildren(...s.rows.map((p) => {
        const li = document.createElement("li");
        const a = document.createElement("span"); a.className = "calc-schedule__what"; a.textContent = p.label;
        const w = document.createElement("small"); w.textContent = p.when; a.append(w);
        const b = document.createElement("span"); b.className = "calc-schedule__amt"; b.textContent = p.amount;
        li.append(a, b); return li;
      }));
      $("plan-note").textContent = s.note;
    }
    // The minimum is stated, never applied: under it, the note says so plainly and stands out.
    const catering = summerFeast ? state.day * FEAST.perGuest + state.evening * FEAST.eveningGuest : 0;
    const under = summerFeast && !!FEAST.minimumSpend && r.priced && catering < FEAST.minimumSpend;
    $("min-note").textContent = summerFeast && FEAST.minimumSpend && r.priced
      ? `* Minimum catering spend is ${pounds(FEAST.minimumSpend)}.` + (under ? ` The catering in this estimate comes to ${pounds(catering)}.` : "") : "";
    $("min-note").classList.toggle("is-under", under);
    $("prepared").textContent = `Prepared ${longDate(today)}${state.coordinator ? ` by ${state.coordinator}` : ""}. `;

    // label each Next button with the section it leads to
    const visible = panels.filter((d) => !d.hidden);
    visible.forEach((d, i) => {
      const btn = d.querySelector<HTMLElement>("[data-next]"); if (!btn) return;
      const next = visible[i + 1];
      btn.hidden = !next;
      if (next) btn.textContent = `Next: ${next.querySelector(".calc-step__title")!.textContent}`;
    });
    const fin = form.querySelector<HTMLElement>("[data-finish]")!;
    fin.querySelector<HTMLElement>(".calc-finish__todo")!.hidden = finished;
    fin.querySelector<HTMLElement>(".calc-finish__done")!.hidden = !finished;

    // keep the address bar shareable
    const u = new URLSearchParams();
    u.set("y", state.year); u.set("m", state.month); u.set("d", state.dayType); if (state.holiday) u.set("h", "1");
    u.set("g", state.day); u.set("e", state.evening);
    u.set("plan", state.plan);
    if (state.date) u.set("date", state.date);
    if (state.couple) u.set("for", state.couple);
    if (state.coordinator) u.set("by", state.coordinator);
    history.replaceState(null, "", `${location.pathname}?${u}${location.hash}`);
  }

  // ---------- events ----------
  const panels = [...form.querySelectorAll<HTMLDetailsElement>("details.calc-step")];

  form.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "date") { state.date = t.value; applyDate(); }
    else if (t.name === "year" || t.name === "dayType") { state[t.name] = t.name === "year" ? Number(t.value) : t.value; state.date = ""; }
    else if (t.name === "month") { state.month = Number(t.value); state.date = ""; }
    else if (t.name === "holiday") state.holiday = t.checked;
    else if (t.name === "couple") state.couple = clean(t.value, 80);
    else if (t.name === "coordinator") {
      state.coordinator = clean(t.value, 60);
      try { localStorage.setItem("styal-calc-coordinator", state.coordinator); } catch { /* storage unavailable */ }
    }
    else if (["day", "evening"].includes(t.name)) { state[t.name] = Number(t.value); clampGuests(); }
    else if (t.name) state[t.name] = t.value;
    syncInputs(); render();
  });
  form.addEventListener("submit", (e) => e.preventDefault());
  // names show on the estimate as they are typed
  form.addEventListener("input", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "couple") { state.couple = clean(t.value, 80); render(); }
    else if (t.name === "coordinator") { state.coordinator = clean(t.value, 60); render(); }
  });
  form.addEventListener("keydown", (e) => { if (e.key === "Enter" && (e.target as HTMLElement).matches("input[type=text], input[type=number]")) e.preventDefault(); });

  form.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-step],[data-next]");
    if (!el) return;
    if (el.dataset.step) {
      const k = el.dataset.step; const jump = 5;
      const cur = state[k]; const dir = Number(el.dataset.dir);
      state[k] = dir > 0 ? Math.floor(cur / jump) * jump + jump : Math.ceil(cur / jump) * jump - jump;
      clampGuests(); syncInputs(); render();
    }
    else if (el.hasAttribute("data-next")) {
      const cur = el.closest("details")!; let next = cur.nextElementSibling as HTMLDetailsElement | null;
      while (next && next.hidden) next = next.nextElementSibling as HTMLDetailsElement | null;
      if (next) { cur.open = false; next.open = true; next.querySelector("summary")!.focus({ preventScroll: true }); next.scrollIntoView({ block: "nearest", behavior: "smooth" }); }
    }
  });

  // one panel open at a time, even where the browser doesn't do it natively
  panels.forEach((d) => d.addEventListener("toggle", () => { if (d.open) panels.forEach((o) => { if (o !== d) o.open = false; }); }));

  document.querySelectorAll("[data-print]").forEach((b) => b.addEventListener("click", () => window.print()));

  // Finish: close the sections, confirm on the left, and draw the eye to the estimate
  form.querySelector("[data-finish-btn]")!.addEventListener("click", () => {
    finished = true; panels.forEach((d) => (d.open = false)); render();
    const est = document.getElementById("estimate")!;
    est.classList.remove("is-ready"); void est.offsetWidth; est.classList.add("is-ready");
    if (window.matchMedia("(max-width: 64em)").matches) est.scrollIntoView({ behavior: "smooth", block: "start" });
    else form.querySelector<HTMLElement>("[data-finish]")!.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });

  // Start again: back to the defaults for the next couple (the coordinator's name stays)
  document.querySelectorAll("[data-reset]").forEach((b) => b.addEventListener("click", () => {
    const keep = state.coordinator;
    Object.assign(state, JSON.parse(JSON.stringify(DEFAULTS)), { coordinator: keep });
    finished = false;
    document.getElementById("estimate")!.classList.remove("is-ready");
    clampGuests(); syncInputs(); panels.forEach((d, i) => (d.open = i === 0)); render();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }));

  document.querySelectorAll<HTMLInputElement>('input[name="season"]').forEach((el) =>
    el.addEventListener("change", () => { if (el.checked) setSeason(el.value as "summer" | "winter"); }));
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]")!;
  copyBtn.addEventListener("click", async () => {
    const original = "Copy a link to this estimate";
    try { await navigator.clipboard.writeText(location.href.split("#")[0]); copyBtn.textContent = "Link copied"; }
    catch { copyBtn.textContent = "Copy the address from your browser bar"; }
    setTimeout(() => (copyBtn.textContent = original), 2400);
  });

  // phone: hide the pinned total while the estimate itself is on screen
  const bar = document.querySelector<HTMLElement>("[data-bar]")!;
  const estimate = document.getElementById("estimate")!;
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(([en]) => bar.classList.toggle("is-hidden", en.isIntersecting), { threshold: 0.05 }).observe(estimate);
  }

  applyDate(); clampGuests(); syncInputs(); render();
</script>

<style is:global>
  /* ============ Wedding calculator ============ */
  .calc-page { padding-bottom: calc(var(--stack-gap) * 1.75); }
  .calc-page :is(label, legend, small, button, input, select, dt, dd, li, .calc-hint, .calc-card__blurb, .calc-card__price, .calc-step__value) { letter-spacing: 0.01em; }

  /* ---- standalone: no site header above, so nothing to offset ---- */
  .calc-page--standalone { --header-h: 0px; padding-top: clamp(1.5rem, 4vw, 3rem); }
  .calc-actions__wide { grid-column: 1 / -1; }
  .calc-foot { margin-top: calc(var(--stack-gap) * 1.2); text-align: center; font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--stone); }

  /* ---- masthead ---- */
  .calc-mast { display: grid; justify-items: center; text-align: center; padding-bottom: calc(var(--stack-gap) * .65); }
  .calc-mast__logo { height: clamp(60px, 7vw, 108px); width: auto; margin-bottom: clamp(1.25rem, 2.5vw, 2rem); }
  .calc-mast .display { font-size: var(--text-xl); }
  .calc-mast .eyebrow { margin-bottom: var(--space-sm); }
  .calc-season { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin: var(--space-md) 0 0; padding: 0; border: 0; }
  .calc-season .calc-chip--season > span { min-width: min(11.5rem, 42vw); min-height: 64px; padding: .5rem 1.2em; border-radius: 999px; font-size: var(--text-base); }
  .calc-mast__lead { margin-top: var(--space-xs); max-width: 52ch; color: var(--stone); font-size: var(--text-sm); letter-spacing: 0.01em; }
  .calc-sample {
    margin-top: var(--space-md); max-width: 60ch; line-height: 1.5; padding: .6em 1.2em; border: 1px dashed var(--taupe); border-radius: var(--radius);
    font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--stone);
  }

  /* ---- layout ---- */
  .calc { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .calc-summary { position: sticky; top: calc(var(--header-h) + 1.25rem); max-height: calc(100vh - var(--header-h) - 2.5rem); overflow-y: auto; overscroll-behavior: contain; }

  /* ---- steps (accordion) ---- */
  .calc-steps { border-top: 1px solid var(--hairline); }
  .calc-step { border-bottom: 1px solid var(--hairline); }
  .calc-step > summary {
    list-style: none; cursor: pointer; display: grid; grid-template-columns: auto 1fr auto auto; align-items: baseline;
    gap: .9rem; padding: 1.15rem .25rem; transition: color .25s ease;
  }
  .calc-step > summary::-webkit-details-marker { display: none; }
  .calc-step > summary:hover { color: var(--accent); }
  .calc-steps { counter-reset: calc-step; }
  .calc-step:not([hidden]) { counter-increment: calc-step; }
  .calc-step__num { font-size: var(--text-xs); letter-spacing: var(--tracking-wide); color: var(--taupe); min-width: 1.2em; }
  .calc-step__num::before { content: counter(calc-step); }
  .calc-step__title { font-size: var(--text-lg); letter-spacing: -0.01em; line-height: 1.2; }
  .calc-step__value { font-size: var(--text-sm); color: var(--stone); text-align: right; }
  .calc-step[open] .calc-step__value { visibility: hidden; }
  .calc-step__chev { width: .55rem; height: .55rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-.2rem) rotate(45deg); transition: transform .3s ease; align-self: center; }
  .calc-step[open] .calc-step__chev { transform: translateY(.1rem) rotate(-135deg); }
  .calc-step__body { padding: .25rem .25rem 1.75rem; display: grid; gap: 1.4rem; }
  @media (prefers-reduced-motion: no-preference) {
    .calc-step[open] .calc-step__body { animation: calc-open .35s ease both; }
    @keyframes calc-open { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  }

  /* ---- fields ---- */
  .calc-field { border: 0; padding: 0; min-width: 0; display: grid; gap: .6rem; }
  .calc-field > legend, .calc-field > label, .calc-stepper label { padding: 0; font-size: var(--text-sm); color: var(--ink); }
  .calc-field > legend { margin-bottom: .6rem; }
  .calc-opt { color: var(--taupe); font-size: var(--text-xs); margin-left: .35em; }
  .calc-hint { font-size: var(--text-xs); color: var(--stone); line-height: 1.5; }

  .calc-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .calc-chip { position: relative; cursor: pointer; }
  .calc-chip input, .calc-card input, .calc-check input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .calc-chip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.15em; border: 1px solid var(--hairline); border-radius: 999px;
    font-size: var(--text-sm); background: transparent; transition: background-color .25s ease, border-color .25s ease, color .25s ease;
  }
  .calc-chip--priced > span { flex-direction: column; justify-content: center; align-items: center; gap: .1rem; min-height: 58px; padding: .35rem 1.1em; border-radius: 16px; line-height: 1.2; }
  .calc-chip--priced > span > span { border: 0; min-height: 0; padding: 0; background: none !important; color: inherit !important; }
  .calc-chip--priced small { font-size: var(--text-xs); opacity: .8; font-variant-numeric: lining-nums; }
  .calc-chip:hover span { border-color: var(--accent); }
  .calc-chip input:checked + span { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .calc-chip input:focus-visible + span, .calc-card:has(input:focus-visible), .calc-check:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }

  .calc-select { position: relative; max-width: 18rem; }
  .calc-select::after { content: ""; position: absolute; right: 1rem; top: 50%; width: .45rem; height: .45rem; border-right: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); transform: translateY(-70%) rotate(45deg); pointer-events: none; }
  .calc-select select, .calc-date input {
    appearance: none; -webkit-appearance: none; width: 100%; min-height: 46px; padding: 0 2.5rem 0 1rem;
    font: inherit; font-size: var(--text-sm); color: var(--ink); background: transparent;
    border: 1px solid var(--hairline); border-radius: var(--radius); cursor: pointer;
  }
  .calc-date { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; }
  .calc-date input { width: auto; padding-right: 1rem; }
  .calc-select select:hover, .calc-date input:hover { border-color: var(--accent); }
  .calc-link { background: none; border: 0; padding: 0 .5rem; min-height: 44px; display: inline-flex; align-items: center; font: inherit; font-size: var(--text-xs); color: var(--stone); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .calc-link:hover { color: var(--accent); }
  .calc-price-line { font-size: var(--text-sm); color: var(--stone); }
  .calc-price-line strong { font-weight: var(--fw-regular); color: var(--ink); font-size: var(--text-base); margin-left: .35em; }

  /* guest steppers */
  .calc-stepper { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .calc-stepper__ctrl { display: inline-flex; align-items: center; border: 1px solid var(--hairline); border-radius: 999px; flex: none; }
  .calc-stepper__ctrl button { width: 46px; height: 46px; border: 0; background: none; font: inherit; font-size: 1.25rem; line-height: 1; color: var(--ink); cursor: pointer; border-radius: 999px; transition: background-color .2s ease, color .2s ease; }
  .calc-stepper__ctrl button:hover { background: var(--accent); color: var(--on-accent); }
  .calc-stepper__ctrl input { width: 3.4rem; border: 0; background: none; text-align: center; font: inherit; font-size: var(--text-base); color: var(--ink); -moz-appearance: textfield; appearance: textfield; }
  .calc-stepper__ctrl input::-webkit-outer-spin-button, .calc-stepper__ctrl input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* option cards */
  .calc-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .calc-cards--slim { grid-template-columns: 1fr; }
  .calc-card {
    position: relative; display: grid; gap: .2rem; padding: 1rem 1.15rem; cursor: pointer;
    border: 1px solid var(--hairline); border-radius: var(--radius); transition: border-color .25s ease, background-color .25s ease;
  }
  .calc-cards--slim .calc-card { grid-template-columns: 1fr auto; column-gap: 1rem; align-items: baseline; }
  .calc-cards--slim .calc-card__blurb { grid-column: 1; }
  .calc-cards--slim .calc-card__price { grid-column: 2; grid-row: 1; margin: 0; }
  .calc-card:hover { border-color: var(--accent); }
  .calc-card:has(input:checked) { border-color: var(--accent); background: var(--surface); box-shadow: inset 0 0 0 1px var(--accent); }
  .calc-card__name { font-size: var(--text-base); line-height: 1.3; }
  .calc-card__blurb { font-size: var(--text-xs); color: var(--stone); line-height: 1.5; }
  .calc-card__price { font-size: var(--text-sm); margin-top: .5rem; white-space: nowrap; }

  /* extras */
  .calc-checks { display: grid; }
  .calc-check { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: .9rem 0; cursor: pointer; border-bottom: 1px solid var(--hairline); }
  .calc-check:last-child { border-bottom: 0; }
  .calc-check__box { width: 22px; height: 22px; border: 1px solid var(--stone); border-radius: 4px; display: grid; place-items: center; transition: background-color .2s ease, border-color .2s ease; }
  .calc-check__box::after { content: ""; width: 10px; height: 5px; border-left: 1.5px solid var(--on-accent); border-bottom: 1.5px solid var(--on-accent); transform: translateY(-1px) rotate(-45deg); opacity: 0; }
  .calc-check input:checked ~ .calc-check__box { background: var(--accent); border-color: var(--accent); }
  .calc-check input:checked ~ .calc-check__box::after { opacity: 1; }
  .calc-check__text { display: grid; }
  .calc-check__name { font-size: var(--text-base); line-height: 1.3; }
  .calc-check__note { font-size: var(--text-xs); color: var(--stone); }
