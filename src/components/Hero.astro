---
import { Image } from "astro:assets";
import hero from "../assets/hero.jpg";
---
<section class="hero" data-hero>
  <div class="hero__masthead container">
    <img class="hero__wordmark" data-hero-wordmark src="/logo-dark.svg" alt="Styal Lodge — Wedding Venue, Cheshire" />
  </div>

  <div class="hero__media">
    <Image
      class="hero__img"
      src={hero}
      alt="Newlyweds share a kiss under a shower of confetti outside Styal Lodge"
      widths={[768, 1200, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <p class="hero__tagline">Beautiful weddings, Exceptional food, Effortless planning</p>
  </div>

  <!-- mobile-only editorial footer -->
  <div class="hero__footer">
    <p class="hero__footer-tagline">Beautiful weddings, Exceptional food, Effortless planning</p>
    <a class="btn btn--solid" href="/book-a-visit">Book a visit</a>
  </div>
</section>

<style>
  /* ---------- DESKTOP (unchanged) ---------- */
  .hero {
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100dvh - var(--header-h));
    display: flex; flex-direction: column;
  }
  .hero__masthead {
    flex: 0 0 auto; display: flex; justify-content: center;
    padding-top: clamp(0rem, 0.2vw, 0.2rem);
    padding-bottom: clamp(0.4rem, 1.2vw, 0.9rem);
  }
  .hero__wordmark { height: clamp(72px, 10.2vw, 160px); width: auto; }
  .hero__media { position: relative; flex: 1 1 auto; min-height: 240px; width: 100%; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; object-position: center 6%; display: block; }
  .hero__media::after {
    content: ""; position: absolute; inset: auto 0 0 0; height: 45%;
    background: linear-gradient(to top, rgba(20,18,16,.5), rgba(20,18,16,0));
    pointer-events: none; z-index: 1;
  }
  .hero__tagline {
    position: absolute; z-index: 2; right: clamp(1rem,3vw,3rem); bottom: clamp(0.7rem,2vh,1.4rem);
    margin: 0; color: var(--bg); text-align: right; font-style: italic; white-space: nowrap;
    font-size: clamp(0.85rem, 0.55rem + 0.85vw, 1.35rem); line-height: 1.3; letter-spacing: -0.02em;
    text-shadow: 0 1px 6px rgba(20,18,16,.4);
  }
  .hero__footer { display: none; }

  /* ---------- MOBILE: editorial "page" — oat space, framed image, stone tagline, sage button ---------- */
  @media (max-width: 64em) {
    .hero {
      min-height: auto; height: auto; display: block;
      padding-top: clamp(0.5rem, 2vh, 1.25rem);
      padding-bottom: clamp(2rem, 7vh, 4rem);
    }
    .hero__masthead {
      display: flex; justify-content: center;
      padding: 0 var(--gutter) clamp(1.25rem, 4vh, 2rem);
    }
    .hero__wordmark { height: clamp(88px, 22vw, 140px); }

    .hero__media {
      position: relative; flex: none;
      width: calc(100% - 2 * var(--gutter)); margin-inline: auto;
      aspect-ratio: 4 / 5; overflow: hidden; min-height: 0;
    }
    .hero__img { width: 100%; height: 100%; object-fit: cover; object-position: center 28%; }
    .hero__media::after { display: none; }
    .hero__tagline { display: none; }

    .hero__footer {
      display: flex; flex-direction: column; align-items: center;
      gap: clamp(1.25rem, 4vh, 2rem); text-align: center;
      padding: clamp(1.75rem, 5vh, 2.75rem) var(--gutter) 0;
    }
    .hero__footer-tagline {
      margin: 0; color: var(--stone); font-style: italic; max-width: 26ch;
      font-size: clamp(1.05rem, 4.6vw, 1.4rem); line-height: 1.4;
    }
  }
</style>
