---
/*
  Wedding calculator — a standalone page for coordinators to use with couples.
  Every price, option and payment plan comes from src/data/pricing.json.
  Nothing here needs editing when prices change.
*/
import Base from "../layouts/Base.astro";
import pricing from "../data/pricing.json";

const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const fmt = (n: number) => "£" + (Number.isInteger(n) ? n.toLocaleString("en-GB") : n.toFixed(2));
const steps = ["Your date", "Your guests", "Feasting", "Drinks", "Finishing touches", "Payment plan"];
const pending = (k: string) => pricing.pendingSections.includes(k);
const onePlan = pricing.payment.plans.length < 2;   // nothing to choose between, so the step is hidden
const SEPARATE = "Priced separately. Your coordinator will take you through the options and prices.";
---
<Base
  title="Wedding calculator — Styal Lodge"
  description="See venue prices for your date at Styal Lodge and how the payments are spread."
  showFloatingCta={false}
>
  <div class="calc-page">
    <header class="calc-mast container">
      <img class="calc-mast__logo" src="/logo-dark.svg" width="971" height="617" alt="Styal Lodge — Wedding Venue, Cheshire" data-hero-wordmark />
      <p class="eyebrow">Plan your day</p>
      <h1 class="display">Wedding <em>calculator</em></h1>
      <p class="calc-mast__lead">Choose your date and guests to see the price for your day and how the payments are spread.</p>
    </header>

    <div class="calc container">
      <form class="calc-steps" id="calc" novalidate>

        <!-- 1. Date -->
        <details class="calc-step" name="calc-step" open>
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[0]}</span>
            <span class="calc-step__value" data-out="s-date"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <fieldset class="calc-field">
              <legend>Year</legend>
              <div class="calc-chips">
                {pricing.years.map((y) => (
                  <label class="calc-chip"><input type="radio" name="year" value={y} /><span>{y}</span></label>
                ))}
              </div>
            </fieldset>
            <div class="calc-field">
              <label for="f-month">Month</label>
              <div class="calc-select">
                <select id="f-month" name="month">
                  {MONTHS.map((m, i) => (<option value={i + 1}>{m}</option>))}
                </select>
              </div>
            </div>
            <fieldset class="calc-field">
              <legend>Day of the week</legend>
              <div class="calc-chips">
                {pricing.dayTypes.map((d) => (
                  <label class="calc-chip"><input type="radio" name="dayType" value={d.id} /><span>{d.short}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="calc-check calc-check--solo">
              <input type="checkbox" name="holiday" value="1" />
              <span class="calc-check__box" aria-hidden="true"></span>
              <span class="calc-check__text">
                <span class="calc-check__name">Bank or public holiday</span>
                <span class="calc-check__note" data-out="holiday-note"></span>
              </span>
            </label>
            <div class="calc-field calc-field--quiet">
              <label for="f-date">Already have a date in mind? <span class="calc-opt">Optional</span></label>
              <div class="calc-date">
                <button type="button" class="calc-next calc-next--small" data-pick-date>Choose a date</button>
                <input type="date" id="f-date" name="date" hidden />
                <button type="button" class="calc-link" data-clear-date hidden>Clear date</button>
              </div>
              <p class="calc-hint">Choosing a date fills in the year, month and day, and puts real dates on your payment plan.</p>
            </div>
            <p class="calc-price-line"><span data-out="hire-label"></span> <strong data-out="hire-inline"></strong> <span data-out="season-inline"></span></p>
            <button type="button" class="calc-next" data-next>Next: {steps[1]}</button>
          </div>
        </details>

        <!-- 2. Guests -->
        <details class="calc-step" name="calc-step">
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[1]}</span>
            <span class="calc-step__value" data-out="s-guests"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            {[
              { id: "day", label: "Day guests", hint: "Ceremony, wedding breakfast and evening" },
              { id: "evening", label: "Evening-only guests", hint: "Joining for the party" },
            ].map((g) => (
              <div class="calc-stepper">
                <div>
                  <label for={`f-${g.id}`}>{g.label}</label>
                  <p class="calc-hint">{g.hint}</p>
                </div>
                <div class="calc-stepper__ctrl">
                  <button type="button" data-step={g.id} data-dir="-1" aria-label={`Fewer: ${g.label}`}>−</button>
                  <input id={`f-${g.id}`} name={g.id} type="number" inputmode="numeric" min="0" step="1" />
                  <button type="button" data-step={g.id} data-dir="1" aria-label={`More: ${g.label}`}>+</button>
                </div>
              </div>
            ))}
            <p class="calc-hint" data-out="guest-note"></p>
            <button type="button" class="calc-next" data-next>Next: {steps[2]}</button>
          </div>
        </details>

        <!-- 3. Feasting -->
        <details class="calc-step" name="calc-step">
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[2]}</span>
            <span class="calc-step__value" data-out="s-food"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <p class="calc-included" data-mode="winter">Included in your winter collection. {pricing.winter.includes}</p>
            {pending("feasting") && <p class="calc-included" data-mode="summer">{SEPARATE}</p>}
            <fieldset class="calc-field" data-mode="summer" hidden={pending("feasting")} data-pending={pending("feasting") ? "" : undefined}>
              <legend>Wedding breakfast</legend>
              <div class="calc-cards">
                {pricing.menus.map((m) => (
                  <label class="calc-card">
                    <input type="radio" name="menu" value={m.id} />
                    <span class="calc-card__name">{m.name}</span>
                    <span class="calc-card__blurb">{m.blurb}</span>
                    <span class="calc-card__price"><span data-price={m.perHead}>{fmt(m.perHead)}</span> per guest</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <fieldset class="calc-field" data-mode="summer" hidden={pending("feasting")} data-pending={pending("feasting") ? "" : undefined}>
              <legend>Evening food</legend>
              <div class="calc-cards calc-cards--slim">
                {pricing.eveningFood.map((m) => (
                  <label class="calc-card">
                    <input type="radio" name="eveFood" value={m.id} />
                    <span class="calc-card__name">{m.name}</span>
                    {m.perHead > 0 && <span class="calc-card__price"><span data-price={m.perHead}>{fmt(m.perHead)}</span> per guest</span>}
                  </label>
                ))}
              </div>
            </fieldset>
            <button type="button" class="calc-next" data-next>Next: {steps[3]}</button>
          </div>
        </details>

        <!-- 4. Drinks -->
        <details class="calc-step" name="calc-step">
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[3]}</span>
            <span class="calc-step__value" data-out="s-drinks"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <p class="calc-included" data-mode="winter">Drinks are included in your winter collection.</p>
            {pending("drinks") && <p class="calc-included" data-mode="summer">{SEPARATE}</p>}
            <fieldset class="calc-field" data-mode="summer" hidden={pending("drinks")} data-pending={pending("drinks") ? "" : undefined}>
              <legend class="visually-hidden">Drinks package</legend>
              <div class="calc-cards calc-cards--slim">
                {pricing.drinks.map((d) => (
                  <label class="calc-card">
                    <input type="radio" name="drinks" value={d.id} />
                    <span class="calc-card__name">{d.name}</span>
                    <span class="calc-card__blurb">{d.blurb}</span>
                    <span class="calc-card__price">{d.perHead > 0 ? (<Fragment><span data-price={d.perHead}>{fmt(d.perHead)}</span> per guest</Fragment>) : "No charge"}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            {pending("extras") && onePlan
              ? <a class="calc-next calc-next--link" href="#estimate">See your estimate</a>
              : <button type="button" class="calc-next" data-next>Next: {pending("extras") ? steps[5] : steps[4]}</button>}
          </div>
        </details>

        <!-- 5. Extras -->
        <details class="calc-step" name="calc-step" hidden={pending("extras")} data-pending={pending("extras") ? "" : undefined}>
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[4]}</span>
            <span class="calc-step__value" data-out="s-extras"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <div class="calc-checks">
              {pricing.extras.map((x) => (
                <label class="calc-check" data-mode={x.summerOnly ? "summer" : undefined}>
                  <input type="checkbox" name="extras" value={x.id} />
                  <span class="calc-check__box" aria-hidden="true"></span>
                  <span class="calc-check__text">
                    <span class="calc-check__name">{x.name}</span>
                    <span class="calc-check__note">{x.note}</span>
                  </span>
                  <span class="calc-check__price"><span data-price={x.price} data-flat={x.per === "flat" ? "" : undefined}>{fmt(x.price)}</span>{x.per === "dayGuest" ? " per guest" : ""}</span>
                </label>
              ))}
            </div>
            {onePlan
              ? <a class="calc-next calc-next--link" href="#estimate">See your estimate</a>
              : <button type="button" class="calc-next" data-next>Next: {steps[5]}</button>}
          </div>
        </details>

        <!-- 6. Payment plan -->
        <details class="calc-step" name="calc-step" hidden={onePlan}>
          <summary>
            <span class="calc-step__num" aria-hidden="true"></span>
            <span class="calc-step__title">{steps[5]}</span>
            <span class="calc-step__value" data-out="s-plan"></span>
            <span class="calc-step__chev" aria-hidden="true"></span>
          </summary>
          <div class="calc-step__body">
            <fieldset class="calc-field">
              <legend class="visually-hidden">Payment plan</legend>
              <div class="calc-cards calc-cards--slim">
                {pricing.payment.plans.map((p) => (
                  <label class="calc-card">
                    <input type="radio" name="plan" value={p.id} />
                    <span class="calc-card__name">{p.name}</span>
                    <span class="calc-card__blurb">{p.summary}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <a class="calc-next calc-next--link" href="#estimate">See your estimate</a>
          </div>
        </details>
      </form>

      <!-- Estimate -->
      <aside class="calc-summary" id="estimate" aria-live="polite">
        <p class="eyebrow">Your estimate</p>
        <p class="calc-summary__total" data-out="total"></p>
        <p class="calc-summary__per" data-out="per-guest"></p>
        <p class="calc-summary__scope" data-out="scope"></p>
        <p class="calc-summary__context" data-out="context"></p>

        <dl class="calc-lines" data-out="lines"></dl>

        <div class="calc-plan">
          <p class="eyebrow">{onePlan ? "Payments" : (<Fragment>Payment plan · <span data-out="plan-name"></span></Fragment>)}</p>
          {onePlan && <span data-out="plan-name" hidden></span>}
          <ol class="calc-schedule" data-out="schedule"></ol>
          <p class="calc-hint" data-out="plan-note"></p>
        </div>

        <div class="calc-actions">
          <a class="btn btn--solid" href="/book-a-visit">Book a visit</a>
          <button type="button" class="btn btn--ghost" data-print>Print or save as PDF</button>
          <button type="button" class="calc-link" data-copy>Copy a link to this estimate</button>
        </div>

        <p class="calc-smallprint">
          <span data-out="prepared"></span>
          An estimate, not a quotation. All rates include VAT and are subject to change; prices and dates are confirmed in your contract.

        </p>
      </aside>
    </div>

    <!-- Phone: running total pinned to the bottom -->
    <a class="calc-bar" href="#estimate" data-bar>
      <span class="calc-bar__label">Your estimate</span>
      <span class="calc-bar__total" data-out="bar-total"></span>
      <span class="calc-bar__go">View</span>
    </a>
  </div>

  <script type="application/json" id="calc-pricing" set:html={JSON.stringify(pricing)} />
</Base>

<script>
  const P = JSON.parse(document.getElementById("calc-pricing")!.textContent!);
  const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const form = document.getElementById("calc") as HTMLFormElement;
  const $ = (k: string) => document.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
  const money = (n: number) => "£" + (Number.isInteger(n) ? n.toLocaleString("en-GB") : n.toLocaleString("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const pounds = (n: number) => "£" + Math.round(n).toLocaleString("en-GB");
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const longDate = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
  const monthYear = (d: Date) => d.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const PENDING = new Set<string>(P.pendingSections);

  // ---------- state ----------
  const years: number[] = P.years;
  const firstYear = years.find((y) => y > today.getFullYear()) ?? years[years.length - 1];
  const state: any = {
    date: "", year: firstYear, month: 6, dayType: "sat", holiday: false,
    day: P.guests.defaultDay, evening: P.guests.defaultEvening,
    menu: P.menus[0].id, eveFood: P.eveningFood[0].id, drinks: P.drinks[1]?.id ?? P.drinks[0].id,
    extras: [] as string[], plan: P.payment.plans[0].id,
  };

  // restore from a shared link
  const q = new URLSearchParams(location.search);
  const has = (list: any[], id: string | null) => !!id && list.some((x) => String(x.id) === id);
  if (q.get("y") && years.includes(Number(q.get("y")))) state.year = Number(q.get("y"));
  if (q.get("m") && +q.get("m")! >= 1 && +q.get("m")! <= 12) state.month = +q.get("m")!;
  if (has(P.dayTypes, q.get("d"))) state.dayType = q.get("d");
  state.holiday = q.get("h") === "1";
  for (const [key, param] of [["day", "g"], ["evening", "e"]] as const) {
    const v = q.get(param); if (v !== null && /^\d{1,3}$/.test(v)) state[key] = +v;
  }
  if (has(P.menus, q.get("menu"))) state.menu = q.get("menu");
  if (has(P.eveningFood, q.get("eve"))) state.eveFood = q.get("eve");
  if (has(P.drinks, q.get("dr"))) state.drinks = q.get("dr");
  if (has(P.payment.plans, q.get("plan"))) state.plan = q.get("plan");
  if (q.get("x")) state.extras = q.get("x")!.split(".").filter((id) => has(P.extras, id));
  if (q.get("date") && /^\d{4}-\d{2}-\d{2}$/.test(q.get("date")!)) state.date = q.get("date");

  // ---------- helpers ----------
  const isWinter = () => P.winter.months.includes(state.month);
  const parseDate = (s: string) => { const [y, m, d] = s.split("-").map(Number); return new Date(y, m - 1, d); };
  const addMonths = (d: Date, n: number) => { const r = new Date(d); const day = r.getDate(); r.setDate(1); r.setMonth(r.getMonth() + n); r.setDate(Math.min(day, new Date(r.getFullYear(), r.getMonth() + 1, 0).getDate())); return r; };

  function applyDate() {
    if (!state.date) return;
    const d = parseDate(state.date);
    if (isNaN(d.getTime()) || !years.includes(d.getFullYear()) || d < today) { state.date = ""; return; }
    state.year = d.getFullYear(); state.month = d.getMonth() + 1;
    state.dayType = P.dayTypes.find((t: any) => t.days.includes(d.getDay()))?.id ?? state.dayType;
  }

  function clampGuests() {
    const g = P.guests;
    state.day = Math.min(g.maxDay, Math.max(2, Math.round(state.day || 0)));
    state.evening = Math.min(Math.max(0, Math.round(state.evening || 0)), Math.max(0, g.maxEveningTotal - state.day));
  }

  // ---------- calculation ----------
  function calculate() {
    const winter = isWinter();
    const dayType = P.dayTypes.find((t: any) => t.id === state.dayType);
    const eveningTotal = state.day + state.evening;
    const menu = P.menus.find((m: any) => m.id === state.menu);
    const eve = P.eveningFood.find((m: any) => m.id === state.eveFood);
    const drinks = P.drinks.find((m: any) => m.id === state.drinks);
    const lines: { label: string; detail: string; amount: number }[] = [];
    const when = state.holiday ? "Bank holiday" : dayType.short;
    let base = 0; let baseLabel = ""; let priced = true;

    if (winter) {
      const c = P.winter.collection[String(state.year)];
      baseLabel = `Winter collection for ${P.winter.includedGuests} guests`;
      if (!c) priced = false;
      else {
        const peak = state.holiday || P.winter.peakDays.includes(state.dayType);
        base = peak ? c.peak : c.offPeak;
        lines.push({ label: baseLabel, detail: `${when}, ${state.year}. Food, drinks and styling included`, amount: base });
        const extra = Math.max(0, state.day - P.winter.includedGuests);
        if (extra > 0) lines.push({ label: "Additional day guests", detail: `${extra} at ${money(c.extraDayGuest)}`, amount: extra * c.extraDayGuest });
        if (state.evening > 0) lines.push({ label: "Evening-only guests", detail: `${state.evening} at ${money(c.eveningGuest)}`, amount: state.evening * c.eveningGuest });
      }
    } else {
      const table = P.summer.hire[String(state.year)];
      baseLabel = "Exclusive use of the Lodge";
      if (!table) priced = false;
      else {
        base = table[state.holiday ? P.summer.holidayRate : state.dayType];
        lines.push({ label: baseLabel, detail: `${when}, ${P.summer.label.toLowerCase().replace("styal", "Styal")} ${state.year}`, amount: base });
        if (!PENDING.has("feasting")) lines.push({ label: `${menu.name} menu`, detail: `${plural(state.day, "guest", "guests")} at ${money(menu.perHead)}`, amount: state.day * menu.perHead });
        if (!PENDING.has("feasting") && eve.perHead > 0) lines.push({ label: eve.name, detail: `${plural(eveningTotal, "guest", "guests")} at ${money(eve.perHead)}`, amount: eveningTotal * eve.perHead });
        if (!PENDING.has("drinks") && drinks.perHead > 0) lines.push({ label: `${drinks.name} drinks`, detail: `${plural(state.day, "guest", "guests")} at ${money(drinks.perHead)}`, amount: state.day * drinks.perHead });
      }
    }
    if (priced && !PENDING.has("extras")) for (const id of state.extras) {
      const x = P.extras.find((e: any) => e.id === id); if (!x || (winter && x.summerOnly)) continue;
      if (x.per === "dayGuest") lines.push({ label: x.name, detail: `${plural(state.day, "guest", "guests")} at ${money(x.price)}`, amount: state.day * x.price });
      else lines.push({ label: x.name, detail: "", amount: x.price });
    }
    lines.forEach((l) => (l.amount = Math.round(l.amount)));   // whole pounds, so the lines always add up to the total
    const total = lines.reduce((s, l) => s + l.amount, 0);
    return { winter, dayType, eveningTotal, menu, eve, drinks, lines, total, base, baseLabel, priced, when };
  }

  function schedule(total: number) {
    const plan = P.payment.plans.find((p: any) => p.id === state.plan) ?? P.payment.plans[0];
    const weeks = P.payment.balanceWeeksBefore;
    const exact = state.date ? parseDate(state.date) : null;
    let balanceWhen = "Before your wedding day";
    if (weeks && exact) { const d = new Date(exact); d.setDate(d.getDate() - weeks * 7); balanceWhen = `By ${longDate(d)}`; }
    else if (weeks) balanceWhen = `${weeks} weeks before your wedding`;
    const rows: { label: string; when: string; amount: string }[] = [];
    let paid = 0;
    plan.steps.forEach((s: any, i: number) => {
      const last = i === plan.steps.length - 1;
      const amount = last ? Math.round(total) - paid : Math.min(Math.round(total) - paid, s.amount != null ? s.amount : Math.round(total * s.share));
      if (!last) paid += amount;
      const when = s.when === "booking" ? "When you book" : s.when === "balance" ? balanceWhen : "Date agreed with your coordinator";
      rows.push({ label: s.label, when, amount: pounds(amount) });
    });
    return { plan, rows, note: P.payment.note ?? "" };
  }

  // ---------- render ----------
  function syncInputs() {
    (form.elements.namedItem("month") as HTMLSelectElement).value = String(state.month);
    (form.elements.namedItem("date") as HTMLInputElement).value = state.date;
    (form.elements.namedItem("holiday") as HTMLInputElement).checked = state.holiday;
    for (const k of ["day", "evening"]) (form.elements.namedItem(k) as HTMLInputElement).value = String(state[k]);
    for (const k of ["year", "dayType", "menu", "eveFood", "drinks", "plan"])
      form.querySelectorAll<HTMLInputElement>(`input[name="${k}"]`).forEach((el) => (el.checked = el.value === String(state[k])));
    form.querySelectorAll<HTMLInputElement>('input[name="extras"]').forEach((el) => (el.checked = state.extras.includes(el.value)));
    form.querySelector<HTMLElement>("[data-clear-date]")!.hidden = !state.date;
    if (state.date) { dateInput.hidden = false; form.querySelector<HTMLElement>("[data-pick-date]")!.hidden = true; }
  }

  function render() {
    const r = calculate();
    const g = P.guests;
    const season = r.winter ? P.winter : P.summer;

    // show the sections that apply to this season
    document.querySelectorAll<HTMLElement>("[data-mode]").forEach((el) => (el.hidden = el.hasAttribute("data-pending") || el.dataset.mode !== (r.winter ? "winter" : "summer")));

    const when = state.date ? longDate(parseDate(state.date)) : `${r.when} · ${MONTHS[state.month - 1]} ${state.year}`;
    $("s-date").textContent = when;
    $("hire-label").textContent = r.baseLabel;
    $("hire-inline").textContent = r.priced ? pounds(r.base) : "to be confirmed";
    $("season-inline").textContent = `(${season.label})`;
    $("holiday-note").textContent = r.winter ? "Charged at the Friday to Sunday rate" : "Charged at the Saturday rate";
    $("s-guests").textContent = `${state.day} day · ${r.eveningTotal} evening`;
    $("guest-note").textContent = `The Lodge welcomes up to ${g.maxDay} guests for the wedding breakfast and ${g.maxEveningTotal} in the evening.` +
      (r.winter ? ` The winter collection is priced for ${P.winter.includedGuests} guests, with additional guests charged separately.` : "");
    $("s-food").textContent = r.winter ? "Included" : PENDING.has("feasting") ? "Priced separately" : (r.eve.perHead > 0 ? `${r.menu.name} · ${r.eve.name}` : r.menu.name);
    $("s-drinks").textContent = r.winter ? "Included" : PENDING.has("drinks") ? "Priced separately" : r.drinks.name;
    const hireOnly = !r.winter && (PENDING.has("feasting") || PENDING.has("drinks"));
    $("scope").textContent = !r.priced ? "" : hireOnly ? "Venue hire only. Catering, drinks, styling and other wedding services are priced separately."
      : r.winter ? "Food, drinks, essential wedding styling and dedicated coordination are included." : "";
    const chosen = state.extras.filter((id: string) => { const x = P.extras.find((e: any) => e.id === id); return x && !(r.winter && x.summerOnly); });
    $("s-extras").textContent = chosen.length ? plural(chosen.length, "extra", "extras") : "None chosen";

    const summary = document.getElementById("estimate")!;
    summary.classList.toggle("is-unpriced", !r.priced);
    $("context").textContent = `${season.label} · ${when} · ${plural(state.day, "day guest", "day guests")}` + (state.evening ? `, ${state.evening} more in the evening` : "");

    if (!r.priced) {
      $("total").textContent = "To be confirmed";
      $("bar-total").textContent = "To be confirmed";
      $("per-guest").textContent = `${season.label} prices for ${state.year} have not been released yet. Please ask your coordinator.`;
      $("lines").replaceChildren(); $("schedule").replaceChildren(); $("plan-note").textContent = "";
      $("s-plan").textContent = P.payment.plans.find((p: any) => p.id === state.plan).name; $("plan-name").textContent = $("s-plan").textContent;
    } else {
      const s = schedule(r.total);
      $("s-plan").textContent = s.plan.name;
      $("total").textContent = pounds(r.total);
      $("bar-total").textContent = pounds(r.total);
      $("per-guest").textContent = hireOnly ? "" : `About ${pounds(r.total / Math.max(1, state.day))} per day guest`;
      $("lines").replaceChildren(...r.lines.map((l) => {
        const row = document.createElement("div"); row.className = "calc-line";
        const dt = document.createElement("dt"); dt.textContent = l.label;
        if (l.detail) { const sm = document.createElement("small"); sm.textContent = l.detail; dt.append(sm); }
        const dd = document.createElement("dd"); dd.textContent = pounds(l.amount);
        row.append(dt, dd); return row;
      }));
      $("plan-name").textContent = s.plan.name;
      $("schedule").replaceChildren(...s.rows.map((p) => {
        const li = document.createElement("li");
        const a = document.createElement("span"); a.className = "calc-schedule__what"; a.textContent = p.label;
        const w = document.createElement("small"); w.textContent = p.when; a.append(w);
        const b = document.createElement("span"); b.className = "calc-schedule__amt"; b.textContent = p.amount;
        li.append(a, b); return li;
      }));
      $("plan-note").textContent = s.note;
    }
    $("prepared").textContent = `Prepared ${longDate(today)}. `;

    // keep the address bar shareable
    const u = new URLSearchParams();
    u.set("y", state.year); u.set("m", state.month); u.set("d", state.dayType); if (state.holiday) u.set("h", "1");
    u.set("g", state.day); u.set("e", state.evening);
    u.set("menu", state.menu); u.set("eve", state.eveFood); u.set("dr", state.drinks); u.set("plan", state.plan);
    if (state.extras.length) u.set("x", state.extras.join("."));
    if (state.date) u.set("date", state.date);
    history.replaceState(null, "", `${location.pathname}?${u}${location.hash}`);
  }

  // ---------- events ----------
  const dateInput = form.elements.namedItem("date") as HTMLInputElement;
  dateInput.min = iso(today > new Date(years[0], 0, 1) ? today : new Date(years[0], 0, 1));
  dateInput.max = `${years[years.length - 1]}-12-31`;

  form.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "date") { state.date = t.value; applyDate(); }
    else if (t.name === "year" || t.name === "dayType") { state[t.name] = t.name === "year" ? Number(t.value) : t.value; state.date = ""; }
    else if (t.name === "month") { state.month = Number(t.value); state.date = ""; }
    else if (t.name === "extras") state.extras = [...form.querySelectorAll<HTMLInputElement>('input[name="extras"]:checked')].map((el) => el.value);
    else if (t.name === "holiday") state.holiday = t.checked;
    else if (["day", "evening"].includes(t.name)) { state[t.name] = Number(t.value); clampGuests(); }
    else if (t.name) state[t.name] = t.value;
    syncInputs(); render();
  });
  form.addEventListener("submit", (e) => e.preventDefault());

  form.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-step],[data-next],[data-clear-date],[data-pick-date]");
    if (!el) return;
    if (el.dataset.step) {
      const k = el.dataset.step; const jump = 5;
      const cur = state[k]; const dir = Number(el.dataset.dir);
      state[k] = dir > 0 ? Math.floor(cur / jump) * jump + jump : Math.ceil(cur / jump) * jump - jump;
      clampGuests(); syncInputs(); render();
    } else if (el.hasAttribute("data-clear-date")) {
      state.date = ""; dateInput.hidden = true; form.querySelector<HTMLElement>("[data-pick-date]")!.hidden = false; syncInputs(); render();
    } else if (el.hasAttribute("data-pick-date")) {
      el.hidden = true; dateInput.hidden = false; dateInput.focus();
      try { (dateInput as any).showPicker?.(); } catch { /* the field is visible and focused, which is enough */ }
    }
    else if (el.hasAttribute("data-next")) {
      const cur = el.closest("details")!; let next = cur.nextElementSibling as HTMLDetailsElement | null;
      while (next && next.hidden) next = next.nextElementSibling as HTMLDetailsElement | null;
      if (next) { cur.open = false; next.open = true; next.querySelector("summary")!.focus({ preventScroll: true }); next.scrollIntoView({ block: "nearest", behavior: "smooth" }); }
    }
  });

  // one panel open at a time, even where the browser doesn't do it natively
  const panels = [...form.querySelectorAll<HTMLDetailsElement>("details.calc-step")];
  panels.forEach((d) => d.addEventListener("toggle", () => { if (d.open) panels.forEach((o) => { if (o !== d) o.open = false; }); }));

  document.querySelector("[data-print]")!.addEventListener("click", () => window.print());
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]")!;
  copyBtn.addEventListener("click", async () => {
    const original = "Copy a link to this estimate";
    try { await navigator.clipboard.writeText(location.href.split("#")[0]); copyBtn.textContent = "Link copied"; }
    catch { copyBtn.textContent = "Copy the address from your browser bar"; }
    setTimeout(() => (copyBtn.textContent = original), 2400);
  });

  // phone: hide the pinned total while the estimate itself is on screen
  const bar = document.querySelector<HTMLElement>("[data-bar]")!;
  const estimate = document.getElementById("estimate")!;
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(([en]) => bar.classList.toggle("is-hidden", en.isIntersecting), { threshold: 0.05 }).observe(estimate);
  }

  applyDate(); clampGuests(); syncInputs(); render();
</script>

<style is:global>
  /* ============ Wedding calculator ============ */
