  .calc-summary { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius); padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: .35rem; scroll-margin-top: calc(var(--header-h) + 1rem); }
