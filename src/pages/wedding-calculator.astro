  }
  .calc-cards--slim .calc-card { grid-template-columns: 1fr auto; column-gap: 1rem; align-items: baseline; }
  .calc-cards--slim .calc-card__blurb { grid-column: 1; }
  .calc-cards--slim .calc-card__price { grid-column: 2; grid-row: 1; margin: 0; }
  .calc-card:hover { border-color: var(--accent); }
  .calc-card:has(input:checked) { border-color: var(--accent); background: var(--surface); box-shadow: inset 0 0 0 1px var(--accent); }
  .calc-card__name { font-size: var(--text-base); line-height: 1.3; }
  .calc-card__blurb { font-size: var(--text-xs); color: var(--stone); line-height: 1.5; }
  .calc-card__price { font-size: var(--text-sm); margin-top: .5rem; white-space: nowrap; }

  /* extras */
  .calc-checks { display: grid; }
  .calc-check { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: .9rem 0; cursor: pointer; border-bottom: 1px solid var(--hairline); }
  .calc-check:last-child { border-bottom: 0; }
  .calc-check__box { width: 22px; height: 22px; border: 1px solid var(--stone); border-radius: 4px; display: grid; place-items: center; transition: background-color .2s ease, border-color .2s ease; }
  .calc-check__box::after { content: ""; width: 10px; height: 5px; border-left: 1.5px solid var(--on-accent); border-bottom: 1.5px solid var(--on-accent); transform: translateY(-1px) rotate(-45deg); opacity: 0; }
